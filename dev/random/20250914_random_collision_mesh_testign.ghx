                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load, json_dump
from compas_rhino.conversions import mesh_to_rhino, mesh_to_compas

fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\robots\setup_objects\endeffectors\ur20\piab_gripper.json"
