print data.keys()

a = mesh_to_rhino(data["collision_mesh"])
b = mesh_to_rhino(data["visual_mesh"])

new_data = {}
new_data["visual_mesh"] = data["visual_mesh"]
new_data["tcf"] = data["tcf"]
new_data["collision_mesh"] = mesh_to_compas(x)
json_dump(fp=fp2, data=new_data, pretty=True)</item>
