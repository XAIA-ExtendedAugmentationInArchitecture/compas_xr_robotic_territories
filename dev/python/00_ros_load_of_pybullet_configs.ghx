                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Point,Frame,Quaternion

frames = []

for list in x:
    point = Point(list[0], list[1], list[2])
    quat = Quaternion(0,0,0,1)
    frame = Frame.from_quaternion(quat)
    frame.point = point
    print('POINT', frame.point.__data__)
    frames.append(frame)</item>
