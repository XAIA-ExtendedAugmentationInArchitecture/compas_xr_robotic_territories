                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino.conversions import plane_to_compas_frame
from compas.data import json_dump

frames = []

for plane in x:
    frame = plane_to_compas_frame(plane)
    frames.append(frame)

fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\ur20\frames_testing.json"
json_dump(frames, fp, True)</item>
