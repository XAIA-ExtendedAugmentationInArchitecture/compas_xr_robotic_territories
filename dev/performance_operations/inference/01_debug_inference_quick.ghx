geometry_frames_names_before_tx = []
geometry_frames_before_tx = []

geometry_frames_names_after_tx = []
geometry_frames_after_tx = []


transformed_geometry_frames = []
transformed_geometry_frames_names = []

for frame in data["geometry_frames_input_before_tx"].items():
    plane = frame_to_rhino_plane(frame[1])
    geometry_frames_before_tx.append(plane)
    geometry_frames_names_before_tx.append(frame[0])


for frame in data["geometry_frames_input_after_tx"].items():
    plane = frame_to_rhino_plane(frame[1])
    geometry_frames_after_tx.append(plane)
    geometry_frames_names_after_tx.append(frame[0])

for frame in data["transformed_geometry_frames"].items():
    plane = frame_to_rhino_plane(frame[1])
    transformed_geometry_frames.append(plane)
    transformed_geometry_frames_names.append(frame[0])

