              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_robots import Configuration
import math

base_rad = math.radians(base)
shoulder_rad = math.radians(shoulder)
elbow_rad = math.radians(elbow)
wrist_1_rad = math.radians(wrist_1)
wrist_2_rad = math.radians(wrist_2)
wrist_3_rad = math.radians(wrist_3)

joint_values = [base_rad, shoulder_rad, elbow_rad, wrist_1_rad, wrist_2_rad, wrist_3_rad]
joint_names = ['shoulder_pan_joint', 'shoulder_lift_joint', 'elbow_joint', 'wrist_1_joint', 'wrist_2_joint', 'wrist_3_joint']
joint_types = [0, 0, 0, 0, 0, 0]

config = Configuration(joint_values, joint_types, joint_names)
</item>
