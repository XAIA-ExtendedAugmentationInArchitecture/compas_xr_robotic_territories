                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_rhino.conversions import frame_to_rhino_plane
from compas_robots import Configuration
from compas.geometry import Frame

joint_names = ['shoulder_pan_joint', 'shoulder_lift_joint', 'elbow_joint', 'wrist_1_joint', 'wrist_2_joint', 'wrist_3_joint']
joint_types = [0, 0, 0, 0, 0, 0]

fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\robots\com_handlers\planning_frames_debug.json"
data = json_load(fp)
approach_pick_plane = frame_to_rhino_plane(data["approach_pick_frame"])
approach_place_plane = frame_to_rhino_plane(data["approach_place_frame"])
place_plane = frame_to_rhino_plane(data["place_frame"])
current_tool_plane = frame_to_rhino_plane(data["current_tool_frame"])
closest_target_plane = frame_to_rhino_plane(data["closest_target_frame"])
exit_safe_frame = frame_to_rhino_plane(data["exit_safe_frame"])
pick_plane = frame_to_rhino_plane(data["pick_frame"])
closest_target_name = data["colsest_target_name"]
current_config = data["current_config"]


completed_items_names = []
completed_items = []
incomplete_items = []
incomplete_items_names = []

for frame in data["completed_items_dict"].items():
    plane = frame_to_rhino_plane(frame[1])
    completed_items.append(plane)
    completed_items_names.append(frame[0])

for frame in data["incompleted_items_dict"].items():
    plane = frame_to_rhino_plane(frame[1])
    incomplete_items.append(plane)
    incomplete_items_names.append(frame[0])
</item>
