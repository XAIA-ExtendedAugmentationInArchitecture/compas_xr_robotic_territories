                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os
from compas_rhino.conversions import box_to_compas, frame_to_rhino
from compas.data import json_dump
from compas.geometry import Rotation
import math


goal_data = {}
goal_data["name"] = name
goal_data["cube_locations"] = {}

goal_fp = os.path.join(folder_fp, str(name+".json"))

box_frames = []


for i,box in enumerate(box_list):
    compas_box = box_to_compas(box)
    if frame_rot:
        Rz90_local = Rotation.from_axis_and_angle(compas_box.frame.zaxis, math.radians(-90), point=compas_box.frame.point)
        rotated_frame = compas_box.frame.transformed(Rz90_local)
        compas_box.frame = rotated_frame
    key = "G"+str(i)
    goal_data["cube_locations"][key] = compas_box
    box_frames.append(frame_to_rhino(compas_box.frame))

if write:
    json_dump(data=goal_data, fp=goal_fp, pretty=True)</item>
