              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_fab.robots.robot import Configuration
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane
from compas_fab.robots import JointTrajectory
import math

pick_planes=[]
exit_planes=[]
move_to_pick_planes=[]
move_planes=[]
place_planes=[]

if group == "bothRRLL":
    group = "robLL_track"
elif group == "bothLLRR":
    group = "robRR_track"

if pick_trajectory:
                for c in pick_trajectory.points:
                    frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                    pick_planes.append(frame_to_rhino_plane(frame))

if exit_trajectory:
                for c in exit_trajectory.points:
                    frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                    exit_planes.append(frame_to_rhino_plane(frame))

if move_to_pick_trajectory:
                for c in move_to_pick_trajectory.points:
                    frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                    move_to_pick_planes.append(frame_to_rhino_plane(frame))

if move_trajectory:
                for c in move_trajectory.points:
                    frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                    move_planes.append(frame_to_rhino_plane(frame))

if place_trajectory:
                for c in place_trajectory.points:
                    frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                    place_planes.append(frame_to_rhino_plane(frame))

if pick_trajectory and exit_trajectory and move_to_pick_trajectory and move_trajectory and place_trajectory:
    full_trajectory_points = exit_trajectory.points + move_to_pick_trajectory.points + \
                 pick_trajectory.points + \
                 list(reversed(pick_trajectory.points)) + \
                 move_trajectory.points + \
                 place_trajectory.points
    
    full_trajectory = JointTrajectory (full_trajectory_points, exit_trajectory.joint_names  )</item>
