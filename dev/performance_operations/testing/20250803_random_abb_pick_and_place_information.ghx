            <chunk name="Object" index="175">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_fab.robots.robot import Configuration
import math


def normalize_joint_values_to_pi(config):
    for i,v in enumerate(config.joint_values):
        if v&gt;math.pi:
            v-=2*math.pi
        if v&lt;-math.pi:
            v+=2*math.pi
        config.joint_values[i]=v
    return config

def remove_other_robot (config, group):
    z_config = robot.zero_configuration(group)
    if group == "robRR_track":
        z_config.joint_values = config.joint_values [:7]
    elif group == "robLL_track":
        z_config.joint_values = config.joint_values [7:]
    return z_config

config = Configuration((0.810, -0.593, 0.279, 0.419, -1.065, -0.942, 0.052,
                         -0.000, -1.443, 0.182, 0.399, -0.081, -1.978, -0.227), 
                         (2, 0, 0, 0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 0), 
                         ('robRR/track_carriage', 'robRR/joint_1', 'robRR/joint_2', 'robRR/joint_3', 
                         'robRR/joint_4', 'robRR/joint_5', 'robRR/joint_6', 'robLL/track_carriage', 
                         'robLL/joint_1', 'robLL/joint_2', 'robLL/joint_3', 'robLL/joint_4', 
                         'robLL/joint_5', 'robLL/joint_6'))

config = normalize_joint_values_to_pi(config)

if test:
    robot.attributes["robLL_track"]["last_config"] = remove_other_robot (config, "robLL_track")
    robot.attributes["robRR_track"]["last_config"] = remove_other_robot (config, "robRR_track")

</item>
