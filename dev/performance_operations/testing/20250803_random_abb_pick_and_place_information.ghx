                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate pickup trajectory of a part.
"""
import math
from ghpythonlib.componentbase import executingcomponent as component
from scriptcontext import sticky as st

from compas.geometry import Frame, Vector
from compas.geometry import Transformation, Translation, Rotation
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane
from compas_fab.ghpython.components import create_id
from compas_fab.robots import AttachedCollisionMesh
from compas_fab.robots import CollisionMesh
from compas_fab.robots import PlanningScene
from compas_fab.robots.robot import Configuration



class PlanPartPickupTrajectory(component):
    
    def RunScript(self, robot, group, current_config, approach_pick_config, approach_place_config, place_config, exit_distance, mesh, planner_id, compute, bang):
        self.Message = ""
        
        def add_other_robot (config):
            z_config = robot.zero_configuration()
            if group == "robRR_track":
                z_config.joint_values[:7] = config.joint_values [:7]
                z_config.joint_values[7:] = robot.attributes["robLL_track"]["last_config"].joint_values
            elif group == "robLL_track":
                z_config.joint_values[:7] = robot.attributes["robRR_track"]["last_config"].joint_values
                z_config.joint_values[7:] = config.joint_values [7:]
            return z_config
        
        def remove_other_robot (config):
            z_config = robot.zero_configuration(group)
            if group == "robRR_track":
                z_config.joint_values = config.joint_values [:7]
            elif group == "robLL_track":
                z_config.joint_values = config.joint_values [7:]
            return z_config
        
        exit_trajectory = None
        move_to_pick_trajectory = None
        place_trajectory = None
        move_trajectory = None
        
        
        exit_safe_config = None
        
        if group == "bothRRLL":
            group = "robRR_track"
        elif group == "bothLLRR":
            group = "robLL_track"
        
        if not approach_pick_config or not place_config or not approach_place_config:
            self.Message = "No approach or place or current config defined"
            return exit_safe_config, exit_trajectory, move_to_pick_trajectory, move_trajectory, place_trajectory
        
        try:

            if compute and robot and robot.client and robot.client.is_connected:
                #Remove Attached_collision mesh from the end effector 
                scene = PlanningScene(robot)
                scene.remove_attached_collision_mesh("attached")
                scene.remove_collision_mesh("attached")
                
                ####################### Current config ########################################
                
                
                ####################### Compute Exit Safe config ########################################
                current_robot_frame = robot.forward_kinematics(current_config, group, options=dict(solver='model'))
                exit_safe_frame = current_robot_frame.translated(current_robot_frame.zaxis*-exit_distance)
                exit_safe_config = robot.inverse_kinematics(exit_safe_frame, current_config, group)
                exit_safe_config = normalize_joint_values_to_pi(exit_safe_config)
                
                
                max_step = 0.05
                frames = [
                           robot.forward_kinematics(c, group, options=dict(solver='model'))
                           for c in (current_config, exit_safe_config)
                         ]
                
                #--------------------- Compute Exit Trajectory -----------------------------------------#
                trajectory = robot.plan_cartesian_motion(frames,
                                                         start_configuration=add_other_robot(current_config),
                                                         group=group,
                                                         options=dict(
                                                             max_step=max_step
                                                             ))
                
                if trajectory.fraction &lt; 1:
                    raise Exception("Incomplete cartesian trajectory found for exit trajectory. Only {:.1f}% of the trajectory could be planned".format(trajectory.fraction * 100))
    
                # Only assign if fraction is full
                exit_trajectory = trajectory
            
            #--------------------- Compute Move to Pick Trajectory -----------------------------------------#
            if compute and robot and robot.client and robot.client.is_connected:
                planner_id = planner_id or 'TRRT'
                
                tolerance_above = self._generate_default_tolerances(robot.get_configurable_joints(group))
                tolerance_below = self._generate_default_tolerances(robot.get_configurable_joints(group))
                goal_constraints = robot.constraints_from_configuration(
                    configuration=remove_other_robot(approach_pick_config),
                    tolerances_above=tolerance_above,
                    tolerances_below=tolerance_below,
                    group=group
                )
                move_to_pick_trajectory = robot.plan_motion(goal_constraints,
                                                                       start_configuration=add_other_robot(exit_safe_config),
                                                                       group=group,
                                                                       options=dict(
                                                                           planner_id=planner_id
                                                                           ))
                
                move_to_pick_trajectory = move_to_pick_trajectory
            
            
            #--------------------- Compute Place Trajectory -----------------------------------------#
            if compute and robot and robot.client and robot.client.is_connected:
                
                max_step = 0.02
                frames = [
                           robot.forward_kinematics(c, group, options=dict(solver='model'))
                            for c in (approach_place_config, place_config)
                         ]
                trajectory = robot.plan_cartesian_motion(frames,
                                                         start_configuration=add_other_robot(approach_place_config),
                                                         group=group,
                                                         options=dict(
                                                             max_step=max_step
                                                         ))
                
                if trajectory.fraction &lt; 0.01:
                    raise Exception("Incomplete cartesian trajectory found. Only {:.1f}% of the trajectory could be planned".format(trajectory.fraction * 100))
    
                # Only assign if fraction is full
                place_trajectory = trajectory
    
                    
                    
            #--------------------- Compute Move Trajectory -----------------------------------------#
            if compute and robot and robot.client and robot.client.is_connected:
                planner_id = planner_id or 'TRRT'
                
                scene = PlanningScene(robot)
                if mesh:
                    transformed_mesh = mesh.transformed(Translation.from_vector(Vector.Zaxis()*0.10)*Rotation.from_axis_and_angle(Vector.Zaxis(), math.radians(90)))
                    cm = CollisionMesh(transformed_mesh, "attached")
                    scene.attach_collision_mesh_to_robot_end_effector(cm, group=group)
                
                
                tolerance_above = self._generate_default_tolerances(robot.get_configurable_joints(group))
                tolerance_below = self._generate_default_tolerances(robot.get_configurable_joints(group))
                goal_constraints = robot.constraints_from_configuration(
                                    configuration=approach_place_config,
                                    tolerances_above=tolerance_above,
                                    tolerances_below=tolerance_below,
                                    group=group
                                    )
                trajectory = robot.plan_motion(goal_constraints,
                                                   start_configuration=add_other_robot(approach_pick_config),
                                                   group=group,
                                                   options=dict(
                                                   planner_id=planner_id,
                                                   ))
                move_trajectory = trajectory
                
            if place_trajectory and move_trajectory and move_to_pick_trajectory and exit_trajectory :
                self.Message = "Found move and place trajectories ({} points)".format(len(exit_trajectory.points) +len(move_to_pick_trajectory.points) +len(move_trajectory.points) + len(place_trajectory.points))
                
                return exit_safe_config, exit_trajectory, move_to_pick_trajectory, move_trajectory, place_trajectory, place_config
                
        except Exception as e:
            print e
            self.Message = "Failed"
            return exit_safe_config, exit_trajectory, move_to_pick_trajectory, move_trajectory, place_trajectory
        
    def _generate_default_tolerances(self, joints):
        DEFAULT_TOLERANCE_METERS = .001
        DEFAULT_TOLERANCE_RADIANS = math.radians(1)

        return [
            DEFAULT_TOLERANCE_METERS if j.is_scalable()
            else DEFAULT_TOLERANCE_RADIANS
            for j in joints
        ]
    
def normalize_joint_values_to_pi(config):
    for i,v in enumerate(config.joint_values):
        if v&gt;math.pi:
            v-=2*math.pi
        if v&lt;-math.pi:
            v+=2*math.pi
        config.joint_values[i]=v
    return config</item>
