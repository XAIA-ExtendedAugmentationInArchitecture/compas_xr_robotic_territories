              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Transformation, Translation, Frame, Rotation
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino
from compas.geometry import scale_vector, Vector
from compas.data import json_dump
import math

a = []
b_out = []
c = []
d = []
e  = []

data_dict = {}

beams = assembly.beams

for b in beams:
    b_len = b.length
    b_frame = b.frame
    b_xaxis = b_frame.xaxis
    b_key = b.key
    d.append(b.key)
    tx = Translation.from_vector(b_xaxis.unitized() * (b_len/2))
    b_frame_txed = b_frame.transformed(tx)
    b_flipped_plane = Frame(b_frame_txed.point, -b_frame_txed.yaxis, -b_frame_txed.xaxis)

    if b_key in horizontal_keys:
        add_rot = Rotation.from_axis_and_angle(b_flipped_plane.yaxis, -math.radians(90), b_flipped_plane.point)
        b_flipped_plane = b_flipped_plane.transformed(add_rot)

    b_place_offset = Translation.from_vector(b_flipped_plane.zaxis.unitized() * 0.02)
    b_final_place = b_flipped_plane.transformed(b_place_offset)

    pick_tx = Translation.from_vector(Vector.Yaxis().unitized() * (b_len/2))
    pick_frame = plane_to_compas_frame(pick_plane_base)
    pick_transformed = pick_frame.transformed(pick_tx)

    data_dict[b_key] = {}
    data_dict[b_key]["place_frame"] = b_final_place
    data_dict[b_key]["pick_frame"] = pick_transformed

    e.append(frame_to_rhino(b_final_place))
    b_out.append(frame_to_rhino(b_frame_txed))
    a.append(frame_to_rhino(b_flipped_plane))

fp=r"C:\Users\jk6372\Desktop\00_ecl_github_repos\00_robotic_fabrication\abbs_irb4600s_fabrication_control\rhino\trajectory_info.json"
json_dump(data=data_dict, fp=fp, pretty=True)

place_frame = data_dict[out_number]["place_frame"]
pick_frame = data_dict[out_number]["pick_frame"]</item>
