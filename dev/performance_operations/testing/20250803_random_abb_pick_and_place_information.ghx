              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math
import Grasshopper
from compas_fab.robots.robot import Joint
from compas_fab.robots.robot import Configuration

if set_joint_positions:
    j = 0
    for i in range(ghenv.Component.Params.Input.Count):
        nslider = ghenv.Component.Params.Input[i].Sources[0]
        if nslider.GetType() == Grasshopper.Kernel.Special.GH_NumberSlider:
            nslider.TrySetSliderValue(math.degrees(joint_positions[j]))
            j += 1

if robot:
    joints = robot.get_configurable_joints()
    joint_types = [joint.type for joint in joints]
    joint_names = [joint.name for joint in joints]
    
    joint_positions = [trackRR, 
                        math.radians(robRR_1), math.radians(robRR_2), 
                        math.radians(robRR_3), math.radians(robRR_4), 
                        math.radians(robRR_5), math.radians(robRR_6),
                        trackLL, 
                        math.radians(robLL_1), math.radians(robLL_2), 
                        math.radians(robLL_3), math.radians(robLL_4), 
                        math.radians(robLL_5), math.radians(robLL_6)]
    
    full_configuration = Configuration(joint_positions, joint_types, joint_names)
    
print(full_configuration)
</item>
