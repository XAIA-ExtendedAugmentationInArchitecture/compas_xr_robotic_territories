                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os
from compas.data import json_load
from compas.datastructures import Assembly
from compas_timber.assembly import TimberAssembly
from compas_timber.planning import BuildingPlan
from compas_timber.consumers import BrepGeometryConsumer
from compas.scene import Scene


if project == 0:
    project_json_fp = os.path.join(fp, "expiriment_02_project_data.json")
else:
    project_json_fp = os.path.join(fp, "expiriment_03_project_data.json")

project_data = json_load(project_json_fp)
config_path = project_data["config_fp"]
project_name = project_data["project_name"]
assembly = TimberAssembly.__from_data__(project_data["assembly"])
building_plan = BuildingPlan.__from_data__(project_data["building_plan"])


if show_geo:
    geometry = []
    scene = Scene()
    consumer = BrepGeometryConsumer(assembly)
    for result in consumer.result:
        scene.add(result.geometry)
        if result.debug_info:
            debug_info.add_feature_error(result.debug_info)
    geometry = scene.draw()</item>
