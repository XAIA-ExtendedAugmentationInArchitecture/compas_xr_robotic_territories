                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino.conversions import plane_to_compas_frame
from compas.geometry import Transformation
from compas.geometry import Frame
from compas.data import json_dump

xyFrame = Frame.worldXY()

tx = Transformation.from_frame_to_frame(xyFrame, xyFrame)
inv_tx = tx.inverse()

print tx.__data__
print inv_tx.__data__

data={}
data["observed"] = {}
data["static"]={}
data["observed"]["inverse_transform_to_observed"] = tx
data["observed"]["transformation_to_urdf"] = inv_tx
data["observed"]["urdf_base_frame"] = xyFrame.transformed(tx)
data["static"]["urdf_base_frame"] = xyFrame

fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\testing\workcell_transformations.json"
json_dump(fp=fp, data=data, pretty=True)</item>
