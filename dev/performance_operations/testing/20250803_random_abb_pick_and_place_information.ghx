                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">def _receive_joint_states(message):
    for key, joint_name in enumerate(message.get('name')):
        print ( message.get('position')[key])
        robot.mobile_client.current_joint_values[joint_name] = message.get('position')[key]


if subscribe:
    robot.mobile_client.topic_subscribe('/joint_states', 'sensor_msgs/JointState', _receive_joint_states)

if unsubscribe:
    robot.mobile_client.topic_unsubscribe('/joint_states')</item>
