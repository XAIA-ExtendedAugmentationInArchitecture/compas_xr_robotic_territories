            <chunk name="Object" index="158">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Grasshopper
import System
import Rhino
import scriptcontext as sc

from ghpythonlib.componentbase import executingcomponent as component
from compas_rhino.conversions import frame_to_rhino_plane

from compas_fab.robots import to_radians
from compas_fab.ghpython.components import create_id

import compas_rrc as rrc

MM_to_M = 0.001

class MyComponent(component):
    
    def RunScript(self, robot, abbs, go):
        key = create_id(self, 'last_config')
        
        frameRR = None
        planeRR = None
        
        frameLL = None
        planeLL = None
        
        
        abbRR = abbs["robRR_track"]
        abbLL = abbs["robLL_track"]
        
        
        if robot and abbs and abbRR.ros.is_connected and abbLL.ros.is_connected and go:
            jointsRR, external_axes_RR = abbRR.send_and_wait(rrc.GetJoints(), timeout=5)
            jointsLL, external_axes_LL = abbLL.send_and_wait(rrc.GetJoints(), timeout=5)
            config = robot.zero_configuration()
            configLL = robot.zero_configuration("robLL_track")
            configRR = robot.zero_configuration("robRR_track")
            
            configRR.joint_values[0]  = external_axes_RR[0] * MM_to_M
            configRR.joint_values[1:7]  = to_radians(jointsRR)
            
#            if all(round(a, 3) == round(b, 3) for a, b in zip(robot.attributes["robRR_track"]["last_config"].joint_values, configRR.joint_values)):
#                robot.attributes["robRR_track"]["changed"] = False
#            else:
#                robot.attributes["robRR_track"]["last_trajectory"]= {}
#                robot.attributes["robRR_track"]["changed"] = True
            
            robot.attributes["robRR_track"]["last_config"] = configRR
            
            configLL.joint_values[0]  = external_axes_LL[0] * MM_to_M
            configLL.joint_values[1:7]  = to_radians(jointsLL)
            
#            if all(round(a, 3) == round(b, 3) for a, b in zip(robot.attributes["robLL_track"]["last_config"].joint_values, configLL.joint_values)):
#                robot.attributes["robLL_track"]["changed"] = False
#            else:
#                robot.attributes["robLL_track"]["last_trajectory"]= {}
#                robot.attributes["robLL_track"]["changed"] = True
                
            robot.attributes["robLL_track"]["last_config"] = configLL
             
            config.joint_values[:7] = configRR.joint_values[:7]
            config.joint_values[7:] = configLL.joint_values[:7]
            
            sc.sticky[key] = config
            
            
        config = sc.sticky.get(key)
        

        if robot and config:
            frameRR = robot.forward_kinematics(config, group = "robRR_track", options=dict(solver='model'))
            frameLL = robot.forward_kinematics(config, group = "robLL_track", options=dict(solver='model'))
            #print frameLL == robot.attributes["robLL_track"]["last_placed_frame"]
            planeRR = frame_to_rhino_plane(frameRR) 
            planeLL = frame_to_rhino_plane(frameLL)

        return (config, frameLL, planeLL, frameRR, planeRR)
</item>
