            <chunk name="Object" index="342">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import compas_rrc as rrc
from compas_fab.robots import to_degrees

M_to_MM = 1000


if group == "bothRRLL":
    group = "robRR_track"
    groupB = "robLL_track"
    both= True
elif group == "bothLLRR":
    group = "robLL_track"
    groupB = "robRR_track"
    both= True

abbA = abbs[groupB]
io_signal_air_A = robot.attributes[groupB]["io_AIR"]
io_signal_gripper_A = robot.attributes[groupB]["io_GRIPPER"]

if robot and abbA and abbA.ros.is_connected and go:
#    total_points = len(exit_trajectory.points)+ len(move_to_pick_trajectory.points)+  len(pick_trajectory.points) * 2 + len(move_trajectory.points) + len(place_trajectory.points)
    
#    abbA.send(rrc.PrintText("Sending {} PnP points for {}. Press play to move".format(total_points, group)))
    abbA.send(rrc.Stop())

    speed = speed or 500
#    abbA.send(rrc.SetDigital(io_signal_air_A, 1))
#    abbA.send(rrc.SetDigital(io_signal_gripper_A, 1))
#    abbA.send(rrc.WaitTime(1))
    print config.joint_values
    joints = to_degrees(config.joint_values[8:])
    ext_axes=[config.joint_values[7]* M_to_MM] 

    abbA.send(rrc.MoveToJoints(joints, ext_axes, speed=speed, zone=rrc.Zone.FINE))
    
#    abbA.send(rrc.SetDigital(io_signal_gripper_A, 0))
#    abbA.send(rrc.WaitTime(1))

    future = abbA.send(rrc.PrintText("Trajectory for {} is done".format(groupB),feedback_level=rrc.FeedbackLevel.DONE))
    
    
    done = future.result(timeout=250.0)
    
</item>
