                      <ARGB>191;160;122;191</ARGB>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A group of Grasshopper objects</item>
                    <item name="ID" index="0" type_name="gh_guid" type_code="9">228c8115-f0d8-4745-892e-1e26febf5f76</item>
                    <item name="ID_Count" type_name="gh_int32" type_code="3">1</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">a60abc3c-ea22-4f65-951a-da3efcbf75fe</item>
