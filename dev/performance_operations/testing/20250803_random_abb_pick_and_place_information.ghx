                              <items count="1">
                                <item name="plane" type_name="gh_plane" type_code="72">
                                  <Ox>3.18024463295441</Ox>
                                  <Oy>0.911662225425947</Oy>
                                  <Oz>0.060402326289317</Oz>
                                  <Xx>0</Xx>
                                  <Xy>-1</Xy>
                                  <Xz>0</Xz>
