                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_fab.robots.robot import Configuration
import math


def normalize_joint_values_to_pi(config):
    for i,v in enumerate(config.joint_values):
        if v&gt;math.pi:
            v-=2*math.pi
        if v&lt;-math.pi:
            v+=2*math.pi
        config.joint_values[i]=v
    return config


config = robot.zero_configuration()
approach_pick_config_LL = Configuration((0.000, 3.042, 0.073, -0.093, -0.000, 1.591, 3.042), 
                        (2, 0, 0, 0, 0, 0, 0), ('robLL/track_carriage', 'robLL/joint_1', 'robLL/joint_2', 
                        'robLL/joint_3', 'robLL/joint_4', 'robLL/joint_5', 'robLL/joint_6'))

approach_pick_config_RR = Configuration((1.596, -0.665, -0.437, 0.898, -0.000, 1.109, 0.905), 
                        (2, 0, 0, 0, 0, 0, 0), ('robRR/track_carriage', 'robRR/joint_1', 'robRR/joint_2', 
                        'robRR/joint_3', 'robRR/joint_4', 'robRR/joint_5', 'robRR/joint_6'))

config.joint_values[:7] = approach_pick_config_RR.joint_values
config.joint_values[7:] = approach_pick_config_LL.joint_values
approach_pick_config = config
approach_pick_config = normalize_joint_values_to_pi(approach_pick_config)

p_config = robot.zero_configuration()
pick_config_LL = Configuration((0.000, 3.042, 0.116, 0.334, 3.142, -1.121, -6.383), 
                            (2, 0, 0, 0, 0, 0, 0), ('robLL/track_carriage', 'robLL/joint_1', 'robLL/joint_2', 
                            'robLL/joint_3', 'robLL/joint_4', 'robLL/joint_5', 'robLL/joint_6'))
                            
pick_config_RR = Configuration((1.475, -0.760, -0.016, 1.001, -0.000, 0.586, 0.811), 
                        (2, 0, 0, 0, 0, 0, 0), ('robRR/track_carriage', 'robRR/joint_1', 'robRR/joint_2', 
                        'robRR/joint_3', 'robRR/joint_4', 'robRR/joint_5', 'robRR/joint_6'))

p_config.joint_values[:7] = pick_config_RR.joint_values
p_config.joint_values[7:] = pick_config_LL.joint_values

pick_config = p_config
pick_config = normalize_joint_values_to_pi(pick_config)



