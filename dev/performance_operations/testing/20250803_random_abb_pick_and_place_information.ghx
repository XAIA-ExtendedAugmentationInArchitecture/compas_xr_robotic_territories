                    <item name="ID" index="1" type_name="gh_guid" type_code="9">759558d3-d2fd-4194-b7e5-f2a5b02b52d3</item>
                    <item name="ID_Count" type_name="gh_int32" type_code="3">2</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">5722bcc7-01b3-4f4f-84da-dae3b573bd4d</item>
                    <item name="Name" type_name="gh_string" type_code="10">Group</item>
