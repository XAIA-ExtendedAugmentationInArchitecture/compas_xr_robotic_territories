              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate placement of a part.
"""
from ghpythonlib.componentbase import executingcomponent as component
#from scriptcontext import sticky as st

from compas.geometry import Frame
from compas.geometry import Transformation, Rotation, Translation, Vector
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane, mesh_to_compas
from compas_fab.ghpython.components import create_id
from compas_fab.robots import PlanningScene, CollisionMesh
from compas.geometry import scale_vector, add_vectors
from compas_fab.robots.robot import Configuration
import math

def normalize_joint_values_to_pi(config):
    for i,v in enumerate(config.joint_values):
        if v&gt;math.pi:
            v-=2*math.pi
        if v&lt;-math.pi:
            v+=2*math.pi
        config.joint_values[i]=v
    return config

class PlacePart(component):
    def RunScript(self, robot, group, approach_pick_config, place_frame, mesh, approach_distance, flip_offset_plane, update):
        self.Message = ""
        
        def add_other_robot (config):
            z_config = robot.zero_configuration()
            if group == "robRR_track":
                z_config.joint_values[:7] = config.joint_values [:7]
                z_config.joint_values[7:] = robot.attributes["robLL_track"]["last_config"].joint_values
            elif group == "robLL_track":
                z_config.joint_values[:7] = robot.attributes["robRR_track"]["last_config"].joint_values
                z_config.joint_values[7:] = config.joint_values [7:]
            return z_config
            
        def remove_other_robot (config):
            z_config = robot.zero_configuration(group)
            if group == "robRR_track":
                z_config.joint_values = config.joint_values [:7]
            elif group == "robLL_track":
                z_config.joint_values = config.joint_values [7:]
            return z_config
            
        if group == "bothRRLL":
            group = "robRR_track"
        elif group == "bothLLRR":
            group = "robLL_track"
            
        if not place_frame:
            raise Exception("No place plane defined")

        place_config = None
        approach_place_config = None
        
        if (update or not place_config or not approach_place_config) and robot and robot.client and robot.client.is_connected:
            
            #Remove Attached_collision mesh from the end effector 
            scene = PlanningScene(robot)
            scene.remove_attached_collision_mesh("attached")
            scene.remove_collision_mesh("attached")
                
            if flip_offset_plane:
                R = Rotation.from_axis_and_angle(place_frame.zaxis, math.radians(180), place_frame.point)
            else:
                R = Rotation.from_axis_and_angle(place_frame.zaxis, math.radians(0), place_frame.point)
            
            place_frame.transform(R)
            place_plane = frame_to_rhino_plane(place_frame)
            
            approach_place_frame = place_frame.translated(place_frame.zaxis*-approach_distance)
            approach_place_plane = frame_to_rhino_plane(approach_place_frame)
            
            try:
                place_config = robot.inverse_kinematics(place_frame, add_other_robot(approach_pick_config), group)
            except:
                raise Exception("Could solve IK solution for place config")
            try:
                approach_place_config = robot.inverse_kinematics(approach_place_frame, add_other_robot(approach_pick_config), group)
            except:
                raise Exception("Could not solve IK solution for approach place config")

        self.Message = "Found place configurations\nusing {:.2f}m approach distance".format(approach_distance)
        
        place_config = normalize_joint_values_to_pi(place_config)
        
        approach_place_config = normalize_joint_values_to_pi(approach_place_config)
        
        return place_config, approach_place_config
