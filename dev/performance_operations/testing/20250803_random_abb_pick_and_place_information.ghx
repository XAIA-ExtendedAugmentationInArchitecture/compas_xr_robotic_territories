                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_dump
from compas_rhino.conversions import mesh_to_compas

mesh_list = []
for m in x:
    compas_mesh = mesh_to_compas(m)
