            <chunk name="Object" index="12">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import compas_rrc as rrc
from compas_fab.robots import to_degrees

M_to_MM = 1000
both = False
def send_trajectory(abb, speed, points, last_point_fine=True):
    for i in range(len(points)):
        c = points[i]
        joints = to_degrees(c.joint_values[1:])
        ext_axes=[c.joint_values[0]* M_to_MM] 
        if i &lt; len(points) - 1:
            zone = rrc.Zone.Z10
        else:
            zone = rrc.Zone.FINE if last_point_fine else rrc.Zone.Z10

        abb.send(rrc.MoveToJoints(joints, ext_axes, speed=speed, zone=zone))

if group == "bothRRLL":
    group = "robRR_track"
    groupB = "robLL_track"
    both= True
elif group == "bothLLRR":
    group = "robLL_track"
    groupB = "robRR_track"
    both= True

abbA = abbs[group]
print (group)
io_signal_air_A = robot.attributes[group]["io_AIR"]
io_signal_gripper_A = robot.attributes[group]["io_GRIPPER"]
print (io_signal_gripper_A)
print (io_signal_air_A)
if robot and abbA and abbA.ros.is_connected and go:
    total_points = len(exit_trajectory.points)+ len(move_to_pick_trajectory.points)+  len(pick_trajectory.points) * 2 + len(move_trajectory.points) + len(place_trajectory.points)
    
    abbA.send(rrc.PrintText("Sending {} PnP points for {}. Press play to move".format(total_points, group)))
    abbA.send(rrc.Stop())

    speed = speed or 500
    abbA.send(rrc.SetDigital(io_signal_air_A, 1))
    abbA.send(rrc.SetDigital(io_signal_gripper_A, 0))
    abbA.send(rrc.WaitTime(1))
    
    
    send_trajectory(abbA, speed, exit_trajectory.points, last_point_fine=False)
    send_trajectory(abbA, speed, move_to_pick_trajectory.points, last_point_fine=False)
    abbA.send(rrc.WaitTime(1))
    send_trajectory(abbA, speed/2, pick_trajectory.points)
    abbA.send(rrc.WaitTime(2))
    abbA.send(rrc.SetDigital(io_signal_gripper_A, 1))
    abbA.send(rrc.WaitTime(1))
    send_trajectory(abbA, speed, list(reversed(pick_trajectory.points)), last_point_fine=False)
    abbA.send(rrc.WaitTime(1))
    send_trajectory(abbA, speed, move_trajectory.points, last_point_fine=False)
    send_trajectory(abbA, speed, place_trajectory.points)

    future = abbA.send(rrc.PrintText("Trajectory for {} is done".format(group),feedback_level=rrc.FeedbackLevel.DONE))
    
    robot.attributes[group]["last_placed_frame"] = robot.forward_kinematics(place_config, group = group, options=dict(solver='model'))
    robot.attributes[group]["last_trajectory"] = {"exit_trajectory":exit_trajectory, 
                                                    "move_to_pick_trajectory":move_to_pick_trajectory, "pick_trajectory":pick_trajectory,
                                                    "move_trajectory":move_trajectory, "place_trajectory":place_trajectory }
    done = future.result(timeout=850.0)
    
    if both:
        abbB = abbs[groupB]
        io_signal_air_B = robot.attributes[groupB]["io_AIR"]
        io_signal_gripper_B = robot.attributes[groupB]["io_GRIPPER"]
        
        if abbB and abbB.ros.is_connected:
            
            total_points = len(exit_trajectory_2.points)+ len(move_to_pick_trajectory_2.points)+  len(pick_trajectory_2.points) * 2 + len(move_trajectory_2.points) + len(place_trajectory_2.points)
            
            abbB.send(rrc.PrintText("Sending {} PnP points for {}. Press play to move".format(total_points, groupB)))
            abbB.send(rrc.Stop())
            abbB.send(rrc.SetDigital(io_signal_air_B, 1))
            abbB.send(rrc.SetDigital(io_signal_gripper_B, 0))
            abbB.send(rrc.WaitTime(1))
            
            
            send_trajectory(abbB, speed, exit_trajectory_2.points, last_point_fine=False)
            abbB.send(rrc.WaitTime(1))
            send_trajectory(abbB, speed/2, move_to_pick_trajectory_2.points, last_point_fine=False)
            abbB.send(rrc.WaitTime(1))
            send_trajectory(abbB, speed, pick_trajectory_2.points)
            abbB.send(rrc.SetDigital(io_signal_gripper_B, 1))
            
            # Ensure abbB completes pick action before abbA releases its grip
            abbB.send_and_wait(rrc.WaitTime(1))  # Ensure time delay before the pick
            abbB.send_and_wait(rrc.SetDigital(io_signal_gripper_B, 1))  # Pick action completed
            
            # Now abbA releases the gripper only after abbB has picked the object
            abbA.send_and_wait(rrc.SetDigital(io_signal_gripper_A, 0))  # Release grip only after abbB picked up
            
            # Wait to ensure abbA's release is processed before continuing
            abbB.send_and_wait(rrc.WaitTime(2))
            
            send_trajectory(abbB, speed, list(reversed(pick_trajectory_2.points)), last_point_fine=False)
            send_trajectory(abbB, speed, move_trajectory_2.points, last_point_fine=False)
            send_trajectory(abbB, speed, place_trajectory_2.points)
        
            abbB.send(rrc.PrintText("Trajectory for {} is done".format(groupB)))
            robot.attributes[groupB]["last_placed_frame"] = robot.forward_kinematics(place_config_2, group = groupB, options=dict(solver='model'))
            robot.attributes[groupB]["last_trajectory"] = {"exit_trajectory":exit_trajectory_2, 
                                                            "move_to_pick_trajectory":move_to_pick_trajectory_2, "pick_trajectory":pick_trajectory_2,
                                                            "move_trajectory":move_trajectory_2, "place_trajectory":place_trajectory_2 }</item>
