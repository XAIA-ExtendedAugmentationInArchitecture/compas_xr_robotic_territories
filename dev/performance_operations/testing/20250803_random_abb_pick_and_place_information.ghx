                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate pickup of a part.
"""
from ghpythonlib.componentbase import executingcomponent as component
from scriptcontext import sticky as st

from compas.geometry import Frame
from compas.geometry import Transformation
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane
from compas_fab.ghpython.components import create_id
from compas_fab.robots import PlanningScene
from compas.geometry import scale_vector, add_vectors
from compas_fab.robots.robot import Configuration
import math

def normalize_joint_values_to_pi(config):
    for i,v in enumerate(config.joint_values):
        if v&gt;math.pi:
            v-=2*math.pi
        if v&lt;-math.pi:
            v+=2*math.pi
        config.joint_values[i]=v
    return config


class PickPart(component):
    def RunScript(self, robot, group, pick_config, pick_planes, approach_pick_config, approach_distance, flip_offset_plane, update):
        self.Message = ""
        
        def add_other_robot (config):
            z_config = robot.zero_configuration()
            if group == "robRR_track":
                print config
                z_config.joint_values[:7] = config.joint_values[:7]
                z_config.joint_values[7:] = robot.attributes["robLL_track"]["last_config"].joint_values
            elif group == "robLL_track":
                z_config.joint_values[:7] = robot.attributes["robRR_track"]["last_config"].joint_values
                z_config.joint_values[7:] = config.joint_values [7:]
            return z_config
        
        def remove_other_robot (config):
            z_config = robot.zero_configuration(group)
            if group == "robRR_track":
                z_config.joint_values = config.joint_values [:7]
            elif group == "robLL_track":
                z_config.joint_values = config.joint_values [7:]
            return z_config
            
        #pick_config = None
        #approach_pick_config = None
        pick_trajectory = None
        pick_frame = None
        pick_plane = None
        approach_pick_plane= None
        
        if group == "bothRRLL":
            group = "robRR_track"
        elif group == "bothLLRR":
            group = "robLL_track"
        
        if pick_planes and pick_config == None :
            pick_plane = pick_planes[group]
            pick_frame = plane_to_compas_frame(pick_planes[group])

        if approach_distance &gt; 0 and not approach_pick_config :
            flip = 1
            if flip_offset_plane:
                flip =-1
            approach_pick_frame = pick_frame.translated(pick_frame.zaxis*approach_distance* flip)
            approach_pick_plane = frame_to_rhino_plane(approach_pick_frame)
            
        scene = PlanningScene(robot)
        scene.remove_attached_collision_mesh("attached")
        scene.remove_collision_mesh("attached") 
            
        if (update or pick_config==None or approach_pick_config==None) and robot and robot.client and robot.client.is_connected:
            try:
                pick_config = robot.inverse_kinematics(pick_frame, robot.zero_configuration(), group)
            except:
                raise Exception("Could not solve IK solution for pick config")
            try:
                approach_pick_config = robot.inverse_kinematics(approach_pick_frame, add_other_robot(pick_config), group)
            except:
                raise Exception("Could not solve IK solution for approach pick config")

        
        # Compute PICK trajectory
        if approach_pick_config and pick_config:
            
            #Remove Attached_collision mesh from the end effector 
            scene = PlanningScene(robot)
            scene.remove_attached_collision_mesh("attached")
            scene.remove_collision_mesh("attached")
            
#            pick_config = normalize_joint_values_to_pi(pick_config) # THE EXTERNAL AXIS VALUES CHANGES
#            approach_pick_config = normalize_joint_values_to_pi(approach_pick_config)  # THE EXTERNAL AXIS VALUES CHANGES
            
            max_step = 0.05
            frames = [
                       robot.forward_kinematics(c, group, options=dict(solver='model'))
                       for c in (approach_pick_config, pick_config)
                     ]
            trajectory = robot.plan_cartesian_motion(frames,
                                                     start_configuration=add_other_robot(approach_pick_config),
                                                     group=group,
                                                     options=dict(
                                                         max_step=max_step,
                                                     ))

            if trajectory.fraction &lt; 0.11:
                raise Exception("Incomplete cartesian trajectory found. Only {:.1f}% of the trajectory could be planned".format(trajectory.fraction * 100))

            # Only assign if fraction is full
            pick_trajectory = trajectory

        self.Message = "Found pick up configurations\nusing {:.2f}m approach distance".format(approach_distance)
        
        return pick_plane, pick_config, approach_pick_plane, approach_pick_config, pick_trajectory
    
    def _offset_approach_frame(self, frame, approach_distance, flip_offset_plane):
        
        frame = frame.copy()
        offset_frame = frame.copy()
            
        if approach_distance &gt; 0:
            frame_normal = offset_frame.normal
            frame_normal_scaled = scale_vector(-frame_normal, approach_distance)
            if(flip_offset_plane):
                frame_normal_scaled = scale_vector(-frame_normal, approach_distance)
            new_frame_origin = add_vectors(offset_frame.point, frame_normal_scaled)
            offset_frame = Frame(new_frame_origin, offset_frame.xaxis, offset_frame.yaxis)
        
        return offset_frame</item>
