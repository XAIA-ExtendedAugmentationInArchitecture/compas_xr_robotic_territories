  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <geom name="ground" type="plane" pos="0 0 0" size="100 100 0.001" quat="1 0 0 0" material="matplane" condim="3" conaffinity="15" />
    <camera name="fixed" pos="0 -3.0 0.8141691543396815" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 0.8141691543396815" xyaxes="1 0 0 0 0 1" />
    <body name="root" pos="0 0 0" quat="1 0 0 0">
    <!-- <body name="root" pos="0 0 0.3141691543396815" quat="1 0 0 0"> -->
      <!-- <freejoint name="root" /> -->
      <site name="imu" size="0.01" pos="0 0 0" />
      <geom pos="0 0 0" quat="-1 0 0 0" type="mesh" rgba="0.7 0.7 0.7 1" mesh="base" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
      <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="base" pos="0 0 0" quat="-1 0 0 0" />
      <body name="shoulder_link" pos="0 0 0.2363" quat="0 0 0 1">
        <inertial pos="0 0 0" mass="16.343" diaginertia="0.0661333 0.0661333 0.0459647" />
        <joint name="shoulder_pan_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-730 730" />
        <geom quat="0 0 0 1" type="mesh" rgba="0.7 0.7 0.7 1" mesh="shoulder" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
        <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="shoulder" quat="0 0 0 1" />
        <body name="upper_arm_link" quat="0.707107 0.707107 0 0">
          <inertial pos="-0.426 0 0.275" mass="29.632" diaginertia="1.83417 1.83417 0.08334" />
          <joint name="shoulder_lift_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-730 730" />
          <geom pos="0 0 0.26" quat="0.5 0.5 -0.5 -0.5" type="mesh" rgba="0.7 0.7 0.7 1" mesh="upperarm" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
          <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="upperarm" pos="0 0 0.26" quat="0.5 0.5 -0.5 -0.5" />
          <body name="forearm_link" pos="-0.862 0 0">
            <inertial pos="-0.36435 0 0.043" mass="7.879" diaginertia="0.359728 0.359728 0.0221597" />
            <joint name="elbow_joint" pos="0 0 0" axis="0 0 1" range="-3.14159 3.14159" actuatorfrcrange="-430 430" />
            <geom pos="0 0 0.043" quat="0.5 0.5 -0.5 -0.5" type="mesh" rgba="0.7 0.7 0.7 1" mesh="forearm" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
            <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="forearm" pos="0 0 0.043" quat="0.5 0.5 -0.5 -0.5" />
            <body name="wrist_1_link" pos="-0.7287 0 0.201">
              <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="3.054" diaginertia="0.00858937 0.00795948 0.00795948" />
              <joint name="wrist_1_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-100 100" />
              <geom pos="0 0 -0.0775" quat="0.707107 0.707107 0 0" type="mesh" rgba="0.7 0.7 0.7 1" mesh="wrist1" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
              <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="wrist1" pos="0 0 -0.0775" quat="0.707107 0.707107 0 0" />
              <body name="wrist_2_link" pos="0 -0.1593 -3.2673e-11" quat="0.707107 0.707107 0 0">
                <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="3.126" diaginertia="0.00879187 0.00814713 0.00814713" />
                <joint name="wrist_2_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-100 100" />
                <geom pos="0 0 -0.0749" quat="1 0 0 0" type="mesh" rgba="0.7 0.7 0.7 1" mesh="wrist2" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="wrist2" pos="0 0 -0.0749" quat="1 0 0 0" />
                <body name="wrist_3_link" pos="0 0.1543 -3.16475e-11" quat="0.707107 -0.707107 0 0">
                  <inertial pos="0 0 -0.025" quat="0.5 0.5 -0.5 0.5" mass="0.846" diaginertia="0.000856575 0.000604537 0.000604537" />
                  <joint name="wrist_3_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-100 100" />
                  <geom pos="0 0 -0.07" quat="0.707107 0.707107 0 0" type="mesh" rgba="0.7 0.7 0.7 1" mesh="wrist3" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
                  <geom type="mesh" rgba="0.7 0.7 0.7 1" mesh="wrist3" pos="0 0 -0.07" quat="0.707107 0.707107 0 0" />
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_pan_joint" joint="shoulder_pan_joint" ctrllimited="true" ctrlrange="-730 730" gear="1" />
    <motor name="shoulder_lift_joint" joint="shoulder_lift_joint" ctrllimited="true" ctrlrange="-730 730" gear="1" />
    <motor name="elbow_joint" joint="elbow_joint" ctrllimited="true" ctrlrange="-430 430" gear="1" />
    <motor name="wrist_1_joint" joint="wrist_1_joint" ctrllimited="true" ctrlrange="-100 100" gear="1" />
    <motor name="wrist_2_joint" joint="wrist_2_joint" ctrllimited="true" ctrlrange="-100 100" gear="1" />
    <motor name="wrist_3_joint" joint="wrist_3_joint" ctrllimited="true" ctrlrange="-100 100" gear="1" />
  </actuator>

  <sensor>
    <actuatorpos name="shoulder_pan_joint_p" actuator="shoulder_pan_joint" />
    <actuatorvel name="shoulder_pan_joint_v" actuator="shoulder_pan_joint" />
    <actuatorfrc name="shoulder_pan_joint_f" actuator="shoulder_pan_joint" noise="0.001" />
    <actuatorpos name="shoulder_lift_joint_p" actuator="shoulder_lift_joint" />
    <actuatorvel name="shoulder_lift_joint_v" actuator="shoulder_lift_joint" />
    <actuatorfrc name="shoulder_lift_joint_f" actuator="shoulder_lift_joint" noise="0.001" />
    <actuatorpos name="elbow_joint_p" actuator="elbow_joint" />
    <actuatorvel name="elbow_joint_v" actuator="elbow_joint" />
    <actuatorfrc name="elbow_joint_f" actuator="elbow_joint" noise="0.001" />
    <actuatorpos name="wrist_1_joint_p" actuator="wrist_1_joint" />
    <actuatorvel name="wrist_1_joint_v" actuator="wrist_1_joint" />
    <actuatorfrc name="wrist_1_joint_f" actuator="wrist_1_joint" noise="0.001" />
    <actuatorpos name="wrist_2_joint_p" actuator="wrist_2_joint" />
    <actuatorvel name="wrist_2_joint_v" actuator="wrist_2_joint" />
    <actuatorfrc name="wrist_2_joint_f" actuator="wrist_2_joint" noise="0.001" />
    <actuatorpos name="wrist_3_joint_p" actuator="wrist_3_joint" />
    <actuatorvel name="wrist_3_joint_v" actuator="wrist_3_joint" />
    <actuatorfrc name="wrist_3_joint_f" actuator="wrist_3_joint" noise="0.001" />
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
  </sensor>
</mujoco>