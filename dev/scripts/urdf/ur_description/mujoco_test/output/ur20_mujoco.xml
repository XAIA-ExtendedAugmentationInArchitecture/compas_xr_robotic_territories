<mujoco model="ur20_robot">
  <option iterations="50" timestep="0.001" solver="PGS" gravity="0 0 -9.81" />

  <compiler angle="radian" eulerseq="zyx" autolimits="true" />
  <!-- <compiler angle="radian" meshdir="meshes" eulerseq="zyx" autolimits="true" /> -->

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01" />
    <geom condim="4" contype="1" conaffinity="15" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
  </default>

  <asset>
    <mesh name="base" content_type="model/stl" file="meshes/ur20/collision/base.stl" />
    <mesh name="shoulder" content_type="model/stl" file="meshes/ur20/collision/shoulder.stl" />
    <mesh name="upperarm" content_type="model/stl" file="meshes/ur20/collision/upperarm.stl" />
    <mesh name="forearm" content_type="model/stl" file="meshes/ur20/collision/forearm.stl" />
    <mesh name="wrist1" content_type="model/stl" file="meshes/ur20/collision/wrist1.stl" />
    <mesh name="wrist2" content_type="model/stl" file="meshes/ur20/collision/wrist2.stl" />
    <mesh name="wrist3" content_type="model/stl" file="meshes/ur20/collision/wrist3.stl" />
    <texture name="texplane" type="2d" builtin="checker" rgb1=".0 .0 .0" rgb2=".8 .8 .8" width="100" height="100" />
    <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />
  </asset>

