              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino import unload_modules
from compas_rhino.conversions import plane_to_compas_frame, box_to_rhino
import Rhino.Geometry as rg

unload_modules("compas_xr")

from compas_xr.project import OptitrackItems, OptiTrackConversions


if not (rb_ids):
    ghenv.Component.Message = "Missing rb_ids"

elif not (rb_names):
    ghenv.Component.Message = "Missing rb_names"

elif not (alignment_plane):
    ghenv.Component.Message = "Missing alignment plane"

elif not (xsize and ysize and zsize):
    ghenv.Component.Message = "Missing box definition"

else:
    ghenv.Component.Message = None
    converted_planes = OptiTrackConversions().convert_to_rhino_planes(rb_planes)
    oi = OptitrackItems(rb_ids, rb_names, converted_planes)
    planes = oi.planes
    alignment_frame = plane_to_compas_frame(alignment_plane)
    transformed_class = oi.transformed_to_alignment_frame(alignment_frame)
    boxes = transformed_class.create_box_geometry_from_items_dict(transformed_class.dict, xsize, ysize, zsize)
    boxes_rhino = [box_to_rhino(b) for b in boxes]
    robot_plane = transformed_class.dict["Robot"]["rhino_plane"]
    
    transformed_planes = transformed_class.planes</item>
