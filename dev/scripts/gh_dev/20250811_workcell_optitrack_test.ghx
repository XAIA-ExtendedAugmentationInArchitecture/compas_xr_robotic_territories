                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas.geometry import Frame
from compas_rhino.conversions import frame_to_rhino_plane, box_to_rhino, plane_to_compas_frame
from compas.geometry import Transformation, Box, Frame

#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250805_194653\rigid_bodies_by_timestamp.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250805_225331\rigid_bodies_by_timestamp.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250805_231118\rigid_bodies_by_timestamp.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250806_152136\rigid_bodies_by_timestamp.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250806_162612\rigid_bodies_by_timestamp.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250806_164509\rigid_bodies_by_timestamp.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\recordings\motive_recordings\2025_anchor_block_test\recordings\20250806_170112\rigid_bodies_by_timestamp.json"

data = json_load(fp)

data_requested = data[input_key]

marker_frames = []
geo_frames = []
geo = []

origin = data["Origin"][0]["marker_rhino_frame"]
trans = Transformation.from_frame_to_frame(Frame.__from_data__(origin), plane_to_compas_frame(to_tx_origin))

for i in range(len(data_requested)):
    f_data = data[input_key][i]["marker_rhino_frame"]
    geo_frame_data = data[input_key][i]["geometry_rhino_frame"]

    frame = Frame.__from_data__(f_data)
    geo_frame = Frame.__from_data__(geo_frame_data)

    if tx:
        frame = frame.transformed(trans)
        geo_frame = geo_frame.transformed(trans)

    box = Box(0.3, 0.3, 0.3, geo_frame)

    marker_frames.append(frame_to_rhino_plane(frame))
    geo_frames.append(frame_to_rhino_plane(geo_frame))
    geo.append(box_to_rhino(box))


