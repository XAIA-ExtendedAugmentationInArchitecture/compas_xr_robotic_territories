            <chunk name="Object" index="98">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.components as ghcomp
import compas_fab
from compas_fab.robots.robot import Configuration

def remap(value, source_min, source_max, target_min, target_max):
    normalized_value = (value - source_min) / (source_max - source_min)
    remapped_value = target_min + normalized_value * (target_max - target_min)
    return remapped_value

def trajectory_points_to_configs(trajectory_points):
    configs = [] 
    for trajectory_point in trajectory_points:
        config = Configuration(trajectory_point.joint_values, trajectory_point.joint_types, trajectory_point.joint_names)
        configs.append(config)
    return configs

for test in selected_list:
    print type(test)
if isinstance(selected_list[0], compas_fab.robots.trajectory.JointTrajectory):
    combined_trajectory_points = []
    for trajectory in selected_list:
        combined_trajectory_points.extend(trajectory.points)
    combined_trajectory_configs = trajectory_points_to_configs (combined_trajectory_points)
    index = int(remap(i, 0.001, 1.00, 0, len(combined_trajectory_configs) - 1))
    index = min(max(0, index), len(combined_trajectory_configs) - 1)
    result = combined_trajectory_configs[index]
elif isinstance(selected_list[0], compas_fab.robots.trajectory.JointTrajectoryPoint):
    index = int(remap(i, 0.001, 1.00, 0, len(selected_list) - 1))
    index = min(max(0, index), len(selected_list) - 1)
    result = selected_list[index]
elif isinstance(selected_list[0], Configuration):
    index = int(remap(i, 0.001, 1.00, 0, len(selected_list) - 1))
    index = min(max(0, index), len(selected_list) - 1)
    result = selected_list[index]
else:
    result = None  

config = result</item>
