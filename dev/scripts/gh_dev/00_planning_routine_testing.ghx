              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate placement of a part.
"""
from ghpythonlib.componentbase import executingcomponent as component
from scriptcontext import sticky as st

#from compas.artists import Artist
from compas.scene import Scene
from compas.geometry import Frame
from compas.geometry import Transformation
from compas_rhino.conversions import plane_to_compas_frame
from compas_fab.ghpython.components import create_id
from compas_fab.robots import PlanningScene
from compas.geometry import scale_vector, add_vectors

class PlacePart(component):
    
    
    def RunScript(self, robot, group, current_config, requested_ik_frames, planner_id, collision_meshes, update):

        motion_ik_solutions = None
        free_motion_trajectories = None
        

        self.Message = ""
        if not current_config or not requested_ik_frames:
            print ('here')
            self.Message = "Missing current config or ik planes"
            return motion_ik_solutions, free_motion_trajectories

        if (update or not motion_ik_solutions or not motion_ik_solutions) and robot and robot.client and robot.client.is_connected:
            scene = PlanningScene(robot)

            frames_list = requested_ik_frames

            try:
                ik_solutions = []

                for i, frame in enumerate(frames_list):
                    if i== 0:
                        start_configuration = current_config
                    else:
                        start_configuration = ik_solutions[-1]
                    ik_solution = robot.inverse_kinematics(frame, start_configuration, group)
                    ik_solutions.append(ik_solution)

                motion_ik_solutions = ik_solutions

            except Exception as e:
                import traceback  # Import traceback for detailed error reporting
                print("Error occurred while solving IK:\n", traceback.format_exc())  # Print full traceback for debugging
                raise Exception("Could not solve IK solution. See error details above.")

        self.Message = "Found IK Solutions for Requested Planes"
        return motion_ik_solutions, free_motion_trajectories

    def _convert_planes_list_to_frames_list(self, planes_list):
        return [plane_to_compas_frame(plane) for plane in planes_list]

    def _generate_default_tolerances(self, joints):
        DEFAULT_TOLERANCE_METERS = .001
        DEFAULT_TOLERANCE_RADIANS = math.radians(1)

        return [
            DEFAULT_TOLERANCE_METERS if j.is_scalable()
            else DEFAULT_TOLERANCE_RADIANS
            for j in joints
        ]
