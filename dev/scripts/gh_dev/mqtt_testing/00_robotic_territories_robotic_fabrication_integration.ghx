              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project import ProjectManager

if not(config_filepath):
    ghenv.Component.Message = "Missing a Config"

elif not(local_directory):
    ghenv.Component.Message = "Missing File Path"

elif not(storage_folder_name):
    ghenv.Component.Message = "Missing Storage Folder Name"

else:
    ghenv.Component.Message = None
    pm = ProjectManager(config_filepath)

    if upload:
        pm.upload_objs_from_directory_to_storage(local_directory, storage_folder_name)
</item>
