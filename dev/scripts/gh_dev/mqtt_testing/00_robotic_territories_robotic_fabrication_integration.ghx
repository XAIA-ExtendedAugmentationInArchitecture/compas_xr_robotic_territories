if not (config_filepath):
    ghenv.Component.Message = "Missing Config or Data"

elif not (project_name):
    ghenv.Component.Message = "Missing Project Name"

elif not (qr_frames):
    ghenv.Component.Message = "Missing QR Frames"

elif not (boundary_zone):
    ghenv.Component.Message = "Missing Boundary Curve"

elif not (infer_pick_zone and infer_collab_zone):
    ghenv.Component.Message = "Missing Infer Curve"

elif not (mimic_human_zone and mimic_robot_zone):
    ghenv.Component.Message = "Missing Mimic Curve"

elif not (tele_mimic_zone):
    ghenv.Component.Message = "Missing TeleMimic Curve"


else:
#    rd = RealtimeDatabase(config_filepath)
#    pm = ProjectManager(config_filepath)
    rtpm = RoboticTerritoriesProjectManager(config_filepath)
    ghenv.Component.Message = None
    
    if upload:
        rtpm.upload_rt_project_data(project_name, qr_frames, boundary_zone, infer_pick_zone, infer_collab_zone, mimic_human_zone, mimic_robot_zone, tele_mimic_zone)
