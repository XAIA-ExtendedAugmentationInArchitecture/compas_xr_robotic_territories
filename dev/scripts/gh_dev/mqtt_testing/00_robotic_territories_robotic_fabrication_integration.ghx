                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Frame, Point, Vector
from compas_rhino.conversions import frame_to_rhino_plane

random_message = {"header":{"device_id":"43346cc4247caff28bb11990cae936d916f49d57","time_stamp":"2025-01-17 19:16:31.601"},"human_frames":[{"point":[0.451,-0.346,0.537],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]},{"point":[1.052,0.163,0.537],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]},{"point":[0.601,0.913,0.537],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]},{"point":[0.601,0.913,1.257],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]}],"robot_frames":[{"point":[0.451,-0.346,0.537],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]},{"point":[1.052,0.163,0.537],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]},{"point":[0.601,0.913,0.537],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]},{"point":[0.601,0.913,1.257],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,-1.00000024,2.38418579E-07]}],"robot_name":"UR20"}

human_frames = random_message["human_frames"]
robot_frames = random_message["robot_frames"]

a = []
b = []

for frame in human_frames:
    print frame
    frame = Frame.__from_data__(frame)
    a.append(frame_to_rhino_plane(frame))
    print type(frame)

for frame in robot_frames:
    print frame
    frame = Frame.__from_data__(frame)
    b.append(frame_to_rhino_plane(frame))
    print type(frame)</item>
