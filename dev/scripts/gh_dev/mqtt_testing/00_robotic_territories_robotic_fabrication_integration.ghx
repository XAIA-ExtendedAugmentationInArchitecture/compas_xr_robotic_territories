                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project import BuildingPlanExtensions
from compas_timber.planning import SimpleSequenceGenerator
from compas_timber.planning import BuildingPlan

if not(assembly):
    ghenv.Component.Message = "Missing a Assembly"

elif not(data_type):
    ghenv.Component.Message = "Missing a data_type"

else:
    ghenv.Component.Message = None
    bpe = BuildingPlanExtensions()
    
    building_plan = bpe.create_buildingplan_from_assembly_sequence(assembly, data_type, robot_keys, priority_lists)
</item>
