                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project import AssemblyExtensions

if not (assembly):
    ghenv.Component.Message = "Missing Assembly"

elif not (new_folder_name and folder_path):
    ghenv.Component.Message = "Missing Folder Name or Path"

else:
    ae = AssemblyExtensions()
    ghenv.Component.Message = None
    
    if export:
        ae.export_timberassembly_objs(assembly, folder_path, new_folder_name, z_to_y_remap)
</item>
