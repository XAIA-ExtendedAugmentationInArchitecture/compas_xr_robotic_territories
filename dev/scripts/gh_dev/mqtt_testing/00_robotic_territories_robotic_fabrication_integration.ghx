                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Frame, Point, Vector
from compas_rhino.conversions import frame_to_rhino_plane

random_message = {"header":{"device_id":"43346cc4247caff28bb11990cae936d916f49d57","time_stamp":"2025-01-17 19:38:25.862"},"human_frames":[{"point":[0.475,0.0,0.606],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[1.037,0.0,0.964],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[0.596,0.753,0.964],"xaxis":[0.5591347,0.8178911,-0.135730162],"yaxis":[-0.744886756,0.4236975,-0.5153875]},{"point":[1.0,0.971,0.964],"xaxis":[0.5551678,0.825250268,0.103686132],"yaxis":[-0.7826476,0.476131678,0.40095064]}],"robot_frames":[{"point":[-1.180782,-9.313226E-10,0.6048551],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[-0.618782043,-9.313226E-10,0.9621787],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[-1.059782,0.7530001,0.9621787],"xaxis":[0.5591347,0.8178911,-0.135730162],"yaxis":[-0.744886756,0.4236975,-0.5153875]},{"point":[-0.655782,0.971,0.9621787],"xaxis":[0.5551678,0.825250268,0.103686132],"yaxis":[-0.7826476,0.476131678,0.40095064]}],"robot_name":"UR20"}
human_frames = random_message["human_frames"]
robot_frames = random_message["robot_frames"]

a = []
b = []

for frame in human_frames:
    print frame
    frame = Frame.__from_data__(frame)
    a.append(frame_to_rhino_plane(frame))
    print type(frame)

for frame in robot_frames:
    print frame
    frame = Frame.__from_data__(frame)
    b.append(frame_to_rhino_plane(frame))
    print type(frame)</item>
