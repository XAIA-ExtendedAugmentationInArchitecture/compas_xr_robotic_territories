                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project import ProjectManager

if not(config_filepath):
    ghenv.Component.Message = "Missing a Config"

elif not(assembly and building_plan and qr_frames):
    ghenv.Component.Message = "Missing a Project Data"

else:
    ghenv.Component.Message = None
    pm = ProjectManager(config_filepath)

    if upload:
        pm.upload_project_data_from_compas(project_name, assembly, building_plan, qr_frames)
</item>
