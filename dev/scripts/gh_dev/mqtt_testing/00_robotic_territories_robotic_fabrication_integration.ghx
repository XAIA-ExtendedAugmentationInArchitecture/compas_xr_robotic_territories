              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino import unload_modules

unload_modules("compas_xr")

from compas_xr.mqtt import MimicTrajectoryRequestMessage

test_message = {"header":{"device_id":"43346cc4247caff28bb11990cae936d916f49d57","time_stamp":"2025-01-18 14:06:31.768"},"human_frames":[{"point":[0.904,-1.144,0.353],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[0.492,0.661,0.353],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[1.588,0.661,1.139],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[1.07,1.186,1.139],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]}],"robot_frames":[{"point":[-0.751782,-1.144,0.352333],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[-1.163782,0.6610001,0.352333],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[-0.0677819252,0.6610001,1.13684809],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]},{"point":[-0.585781932,1.186,1.13684809],"xaxis":[1.0,0.0,0.0],"yaxis":[0.0,1.0,0.0]}],"robot_name":"UR20"}

msgClass = MimicTrajectoryRequestMessage.parse(test_message)

print(msgClass.human_frames)
print(msgClass.robot_frames)
print(msgClass.robot_name)
print(msgClass.header.device_id)
print(msgClass.header.time_stamp)

</item>
