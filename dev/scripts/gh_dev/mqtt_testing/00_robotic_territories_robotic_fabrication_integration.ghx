                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math
import os
import sys

import compas
from compas.geometry import Box
from compas.geometry import Frame
from compas.geometry import Vector
from compas.geometry import Polyhedron
from compas.datastructures import Assembly
from compas.datastructures import Part

from compas.itertools import linspace
from compas_rhino.conversions import surface_to_compas, box_to_rhino

if not options:
    ghenv.Component.Message = "Need Options for Sizing"

else:
    xsize = options.xsize
    ysize = options.ysize
    zsize = options.zsize
    xgap = options.xgap
    zgap = options.zgap

    surface = surface_to_compas(surface)
    
    parts_geo = []
    part_frames = []
    priority_lists = []
    
    wall_vertical_curve = surface.v_isocurve(0)
    wall_height = wall_vertical_curve.length()
    courses = int(math.ceil((wall_height / (zsize + zgap))))
    
    assembly = Assembly()
    half_brick = Box.from_diagonal([(-xsize / 4, -ysize / 2, 0), (xsize / 4, ysize / 2, -zsize)])
    full_brick = Box.from_diagonal([(-xsize / 2, -ysize / 2, 0), (xsize / 2, ysize / 2, -zsize)])
    
    part_index = 0
    for ri, row in enumerate(linspace(0, 1, courses)):

        row_keys = []
        _, u = wall_vertical_curve.rhino_curve.NormalizedLengthParameter(row)

        row_curve = surface.u_isocurve(u)
        row_length = row_curve.length()
        
        c = (row_length / (xsize + xgap))
        col_count = int(math.ceil(c))
        linspaced_vector = list(linspace(0, 1, col_count))
        half_brick_offset = linspaced_vector[1] / 2
        
        for ci, l in enumerate(linspaced_vector):
            if ri % 2:
                l += half_brick_offset
            if ci == 0 and ri % 2 == 0:
                l += half_brick_offset / 2
            if ci == col_count - 1 and ri % 2 == 0:
                l -= half_brick_offset / 2
            
            fits, col = row_curve.rhino_curve.NormalizedLengthParameter(l)
            if not fits: break
    
            point = row_curve.point_at(col)
            xaxis = row_curve.tangent_at(col)
            frame = Frame(point, -xaxis, xaxis.cross(Vector.Zaxis()))
    
            if ri % 2 == 0 and ci in (0, col_count - 1):
                brick = half_brick.copy()
            else:
                brick = full_brick.copy()
            
            brick.frame = frame
            assembly.add_part(brick)
            row_keys.append(str(part_index))
            part_index += 1
        priority_lists.append(row_keys)

    # Assembly attributes
    assembly.attributes['courses'] = ri
    parts_geo = [box_to_rhino(part) for part in assembly.parts()]
    part_frames = [part.frame for part in assembly.parts()]</item>
