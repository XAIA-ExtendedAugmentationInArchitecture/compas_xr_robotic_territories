            <chunk name="Object" index="103">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_dumps, json_dump

from compas_timber.planning import SimpleSequenceGenerator
from compas_timber.planning import BuildingPlan


if not (path_local):
    ghenv.Component.Message = "Missing a Path"

elif not(assembly):
    ghenv.Component.Message = "Missing a Assembly"

elif not(data_type):
    ghenv.Component.Message = "Missing a data_type"

else:
    #component message = none
    ghenv.Component.Message = None
    
    #Compas_xr data_types
    data_type_list = ['0.Cylinder','1.Box','2.ObjFile']
    
    #Generate Building Plan
    building_plan = SimpleSequenceGenerator(assembly).result
    
    
    
    print (len(building_plan.steps))
    
    k=0
    #Set Generic Info
    for step in building_plan.steps:
        
        #Set data_type_from input
        step.geometry = data_type_list[data_type]
        step.instructions = ["none"]
        #Temporary: This should come planner
        step.elements_held = [1]
        
        #Temporary Important Data for testing.
        element_key = str(step.element_ids[0])

        #Set Robot keys if input for robot keys
        if robot_keys:
                if element_key in robot_keys:
                    step.actor = "ROBOT"

        if not priority_lists:
            step.priority = 0
        else:
            j=0
            for i, priority_list in enumerate(priority_lists):
                if element_key in priority_list:
                    print ("Key {} is in list {}".format(element_key, i))
                    step.priority = i
                    break
                j+=1
            
            print ("I iterated {} times".format(j))
        k+=1
    print ("And I iterated {} times".format(k))     

    
    #Overall Data Formatting
    export_data = {
        "assembly": assembly.__data__,
        "beams": {beam.key: beam for beam in assembly.beams},
        "joints": {joint.key: joint for joint in assembly.joints},
        "building_plan": building_plan
    }
    
    #Output data
    data = [export_data]
    
    #Export data to file
    if export:
        json_dump(export_data, path_local, pretty=True)
</item>
