              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')
from compas_xr.project import ProjectManager

if not(config_filepath):
    ghenv.Component.Message = "Missing a Config"

elif not(compas_object):
    ghenv.Component.Message = "Missing Assembly"

elif not(cloud_file_name):
    ghenv.Component.Message = "Missing Cloud File Name"

else:
    ghenv.Component.Message = None
    pm = ProjectManager(config_filepath)

    if upload:
        pm.upload_compas_object_to_storage(compas_object, cloud_file_name, pretty)
</item>
