                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino.conversions import plane_to_compas_frame
from compas.datastructures import Assembly

frame_assembly = Assembly()

for plane in x:
    frame = plane_to_compas_frame(plane)
    frame_assembly.add_part(frame)


for part in frame_assembly.parts():
    print ("FRAME" , part.frame)</item>
