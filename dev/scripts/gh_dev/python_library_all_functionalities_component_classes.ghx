              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_timber.planning import Step
from compas_timber.planning import BuildingPlan
from compas.geometry import Frame
from compas_rhino.conversions import frame_to_rhino_plane
from compas_rhino.conversions import box_to_rhino
from compas_timber.parts import Beam

planes = []
built_human = []
unbuilt_human = []
built_robot = []
unbuilt_robot = []

nodes = assembly.graph.__data__["node"]
buildingplan = data["building_plan"]

try:
    last_built_index = buildingplan["data"]["LastBuiltIndex"]
except:
    last_built_index = None

steps = buildingplan["data"]["steps"]

for i in range(len(steps)):
    
    location = steps[i]["data"]["location"]
    point = location["point"]
    xaxis = location["xaxis"]
    yaxis = location["yaxis"]
    frame = Frame(point, xaxis, yaxis)
    planes.append(frame_to_rhino_plane(frame))
    
    isbuilt = steps[i]["data"]["is_built"]
    element_ids = steps[i]["data"]["element_ids"]
    actor = steps[i]["data"]["actor"]
    
    if isbuilt:
        if actor == "HUMAN":
            for id in element_ids:
                part = nodes[str(id)]['part']
                box = part.blank
                built_human.append(box_to_rhino(box))
        else:
            for id in element_ids:
                part = nodes[str(id)]['part']
                box = part.blank
                built_robot.append(box_to_rhino(box))
    else:
        if actor == "HUMAN":
            for id in element_ids:
                part = nodes[str(id)]['part']
                print part
                box = part.blank
                unbuilt_human.append(box_to_rhino(box))
        else:
            for id in element_ids:
                part = nodes[str(id)]['part']
                box = part.blank
                unbuilt_robot.append(box_to_rhino(box))</item>
