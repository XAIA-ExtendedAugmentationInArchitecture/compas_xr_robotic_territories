                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.storage import Storage
from compas.data import json_dumps


if "deep_data" not in globals():
    deep_data = None

if not (config_filepath and cloud_path_list):
    ghenv.Component.Message = "Missing Config or Cloud Path List"

else:
    st = Storage(config_filepath)
    ghenv.Component.Message = None
    
    if get:
        print
        data = st.get_data_from_deep_reference(cloud_path_list)
        deep_data = data

    data = [deep_data]</item>
