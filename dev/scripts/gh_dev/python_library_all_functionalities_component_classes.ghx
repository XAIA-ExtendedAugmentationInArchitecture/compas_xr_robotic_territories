              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_timber.assembly import TimberAssembly
import os
import json
from compas.data import json_load
from compas.scene import Scene
from compas_timber.consumers import BrepGeometryConsumer

path = str(path)

timber_assembly = json_load(path)

frames = []

for beam in timber_assembly.beams:
    frame = beam.frame
    frames.append(frame)

scene = Scene()

if show:
    vis_consumer = BrepGeometryConsumer(timber_assembly)
    for result in vis_consumer.result:
        scene.add(result.geometry)
        if result.debug_info:
            debug_info.add_feature_error(result.debug_info)
else:
    for beam in timber_assembly.beams:
        scene.add(beam.blank)

Geometry = scene.draw()
</item>
