              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">#from compas_timber.consumers import BrepGeometryConsumer
#from compas.geometry import Frame, Point, Vector
#from compas.datastructures import Mesh
#from compas_rhino.conversions import mesh_to_compas
#import Rhino.Geometry as rg
#from compas.datastructures import Mesh
#import os
#
#from compas.geometry import Transformation, Frame

from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.project import AssemblyExtensions

if not (assembly):
    ghenv.Component.Message = "Missing Assembly"

elif not (new_folder_name and folder_path):
    ghenv.Component.Message = "Missing Folder Name or Path"

else:
    ae = AssemblyExtensions()
    ghenv.Component.Message = None
    
    if export:
        ae.export_mesh_assembly_objs(assembly, folder_path, new_folder_name, z_to_y_remap)
</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
                    <item name="EditorLocation" type_name="gh_drawing_point" type_code="30">
                      <X>39</X>
