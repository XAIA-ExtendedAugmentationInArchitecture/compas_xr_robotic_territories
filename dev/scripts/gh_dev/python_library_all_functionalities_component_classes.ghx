            <chunk name="Object" index="313">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Frame, Box
from compas.datastructures import Mesh, Assembly

frame_1 = Frame.worldXY()
frame_2 = Frame.worldZX()

box_1 = Box(frame=frame_1)
box_1_verts, box_1_faces = box_1.to_vertices_and_faces()

box_2 = Box(frame=frame_2)
box_2_verts, box_2_faces = box_2.to_vertices_and_faces()

box_1_mesh = Mesh.from_vertices_and_faces(box_1_verts, box_1_faces)
box_2_mesh = Mesh.from_vertices_and_faces(box_2_verts, box_2_faces)

mesh_assembly = Assembly()
frame_assembly = Assembly()

mesh_assembly.add_part(box_1_mesh)
mesh_assembly.add_part(box_2_mesh)

frame_assembly.add_part(frame_1)
frame_assembly.add_part(frame_2)

for mesh_part in mesh_assembly.parts():
    print mesh_part.frame

for frame_part in frame_assembly.parts():
    print frame_part.frame
</item>
