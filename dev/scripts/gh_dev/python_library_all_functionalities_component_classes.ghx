                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.realtime_database import RealtimeDatabase
from compas.data import json_dumps


if "ref_list_realtime_data" not in globals():
    ref_list_realtime_data = None

if not (config_filepath):
    ghenv.Component.Message = "Missing Config"

elif not (reference_list):
    ghenv.Component.Message = "Missing Reference List"

else:
    rd = RealtimeDatabase(config_filepath)
    ghenv.Component.Message = None
    
    if get:
        data = rd.get_data_from_deep_reference(reference_list)
        ref_list_realtime_data = [data]
    
    data = ref_list_realtime_data
</item>
