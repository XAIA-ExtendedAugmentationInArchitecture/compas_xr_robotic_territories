              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.project import ProjectManager
from compas_timber.planning.sequencer import BuildingPlan

last_built_index = None
step_locations = None
built_human = None
unbuilt_human = None
built_robot = None
unbuilt_robot = None

if "timbers_project_data" not in globals():
    timbers_project_data = {}

if not (config_filepath):
    ghenv.Component.Message = "Missing Config"

elif not (project_name):
    ghenv.Component.Message = "Missing Project Name"

elif not (timber_assembly):
    ghenv.Component.Message = "Missing Assembly"

else:
    pm = ProjectManager(config_filepath)
    ghenv.Component.Message = None
    
    if visualize:
        last_built_index, step_locations, built_human, unbuilt_human, built_robot, unbuilt_robot = pm.visualize_project_state_timbers(timber_assembly, project_name)
        timbers_project_data["last_built_index"] = last_built_index
        timbers_project_data["step_locations"] = step_locations
        timbers_project_data["built_human"] = built_human
        timbers_project_data["unbuilt_human"] = unbuilt_human
        timbers_project_data["built_robot"] = built_robot
        timbers_project_data["unbuilt_robot"] = unbuilt_robot

if timbers_project_data:
    last_built_index = timbers_project_data["last_built_index"]
    step_locations = timbers_project_data["step_locations"]
    built_human = timbers_project_data["built_human"]
    unbuilt_human = timbers_project_data["unbuilt_human"]
    built_robot = timbers_project_data["built_robot"]
    unbuilt_robot = timbers_project_data["unbuilt_robot"]</item>
