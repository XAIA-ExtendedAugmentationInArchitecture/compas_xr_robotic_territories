                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.datastructures import Assembly
from compas_rhino.conversions import plane_to_compas_frame
from compas.geometry import Box
from compas.data import json_load

random_assembly = Assembly()

for plane in x:
    frame = plane_to_compas_frame(plane)
    
    box = Box(0.1,0.1,0.1,frame=frame)
    
    random_assembly.add_part(box, frame=frame)

data = random_assembly.__data__
graph_data = random_assembly.graph.__data__


