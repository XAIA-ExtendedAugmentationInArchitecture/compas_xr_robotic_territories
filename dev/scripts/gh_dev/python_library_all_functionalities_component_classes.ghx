                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.storage import Storage
from compas.data import json_dumps

if not (config_filepath and directory_path and cloud_path_list):
    ghenv.Component.Message = "Missing Config, directory_path, or cloud_path_list"

else:
    st = Storage(config_filepath)
    ghenv.Component.Message = None
    
    if upload:
        upload = st.upload_files_as_bytes_from_directory_to_deep_reference(directory_path, cloud_path_list)</item>
