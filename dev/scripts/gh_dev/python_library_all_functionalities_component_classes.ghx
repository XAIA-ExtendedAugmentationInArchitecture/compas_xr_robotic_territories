                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.realtime_database import RealtimeDatabase
from compas.data import json_dumps


if not (data and config_filepath):
    ghenv.Component.Message = "You are missing data or Config"

elif not (parentname and childname):
    ghenv.Component.Message = "Missing Parentname or Childname"

else:
    rd = RealtimeDatabase(config_filepath)
    ghenv.Component.Message = None
    
    if upload:
        upload = rd.upload_data_to_reference_as_child(data, parentname, childname)
#    
#    if upload == True:
#        ghenv.Component.Message = "Json Uploaded"
#    else:
#        ghenv.Component.Message = "Json failed to upload"
