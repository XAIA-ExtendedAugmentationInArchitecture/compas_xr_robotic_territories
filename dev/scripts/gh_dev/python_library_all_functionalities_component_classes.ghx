                    <item name="CodeInput" type_name="gh_string" type_code="10">priority_tree = []

# Define start and end indexes for each priority
priority_0_start, priority_0_end = 0, 8
priority_1_start, priority_1_end = 8, 16
priority_2_start, priority_2_end = 16, 25
priority_3_start, priority_3_end = 25, 32
priority_4_start, priority_4_end = 32, 36

# Apply list slicing
priority_0 = x[priority_0_start:priority_0_end]
priority_1 = x[priority_1_start:priority_1_end]
priority_2 = x[priority_2_start:priority_2_end]
priority_3 = x[priority_3_start:priority_3_end]
priority_4 = x[priority_4_start:priority_4_end]


priority_0_keys = []
for i in range(priority_0_start,priority_0_end):
    priority_0_keys.append(str(i))
priority_tree.append(priority_0_keys)

priority_1_keys = []
for i in range(priority_1_start,priority_1_end):
    priority_1_keys.append(str(i))
priority_tree.append(priority_1_keys)

priority_2_keys = []
for i in range(priority_2_start,priority_2_end):
    priority_2_keys.append(str(i))
priority_tree.append(priority_2_keys)

priority_3_keys = []
for i in range(priority_3_start,priority_3_end):
    priority_3_keys.append(str(i))
priority_tree.append(priority_3_keys)

priority_4_keys = []
for i in range(priority_4_start,priority_4_end):
    priority_4_keys.append(str(i))
priority_tree.append(priority_4_keys)

print (priority_tree)

