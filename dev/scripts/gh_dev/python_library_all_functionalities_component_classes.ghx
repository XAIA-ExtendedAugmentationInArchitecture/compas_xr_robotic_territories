                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.datastructures import Assembly, Part
from compas.geometry import Frame
from compas.data import json_dumps
from compas.data import Data
from compas.geometry import Polyhedron
from compas.geometry import Box
from compas.geometry import Sphere
from compas.geometry import Cylinder
from compas.datastructures import Mesh
from compas_rhino.conversions import plane_to_compas_frame


assembly = Assembly()

boxassembly = Assembly()
boxPartAssembly = Assembly()

cylinder_assembly = Assembly()
cylinderPartAssembly = Assembly()

mesh_assembly = Assembly()
meshPartAssembly = Assembly()

frameAssembly = Assembly()

frame_data = {}
frames = []
boxes = []
cylinders = []
meshes = []

for i, plane in enumerate(planes):
    
    origin_frame = Frame.worldXY()
    frame = plane_to_compas_frame(plane)
    frame_data.update({str(i) : frame.__data__})

    box = Box(x, y, z, frame)
    boxPart = Part(name=str(i), frame=origin_frame, shape=box)
    boxPart = Part(box, frame=frame)
    boxPartAssembly.add_part(boxPart)
    box_vert, box_faces = box.to_vertices_and_faces()

    cylinder = Cylinder(radius=100, height=x, frame=origin_frame)
    cylinderPart = Part(name=str(i), frame=origin_frame, shape=cylinder)
    cylinderPart = Part(cylinder, frame=frame)
    cylinderPartAssembly.add_part(cylinderPart)

    mesh = Mesh.from_vertices_and_faces(box_vert, box_faces)
    meshPart = Part(name=str(i), frame=origin_frame, shape=mesh)
    meshPart = Part(mesh, frame=frame)
    meshPartAssembly.add_part(meshPart)

    meshes.append(mesh)
    cylinders.append(cylinder)
    boxes.append(box)
    frames.append(frame)

    mesh_assembly.add_part(mesh, frame=frame)
    cylinder_assembly.add_part(cylinder, frame=origin_frame)
    boxassembly.add_part(box, frame=origin_frame)
    part = Part(str(i), frame=frame)
    assembly.add_part(part)
    
    framePart = Part(frame, frame=frame)
    frameAssembly.add_part(frame, frame=frame)
    



assembly_data = json_dumps(assembly, pretty=True)
frame_data = [{"frames": frame_data, "random": 0}]
single_frame = [frames[0].__data__]
</item>
