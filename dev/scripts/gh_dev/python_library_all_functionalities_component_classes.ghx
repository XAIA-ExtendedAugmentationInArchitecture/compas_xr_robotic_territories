                    <item name="CodeInput" type_name="gh_string" type_code="10">
from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os

from compas_xr.storage import Storage
from compas.data import json_dumps


if "static_folder_data" not in globals():
    static_folder_data = None

if not (config_filepath and cloud_file_name and cloud_folder_name):
    ghenv.Component.Message = "Missing Config, Foldername, or Filename"

else:
    st = Storage(config_filepath)
    ghenv.Component.Message = None
    
    if get:
        data = st.get_data_from_folder(cloud_folder_name, cloud_file_name)
        static_folder_data = data

    data = [static_folder_data]</item>
