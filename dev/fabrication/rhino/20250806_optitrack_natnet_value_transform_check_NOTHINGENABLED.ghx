                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Frame, Point, Vector
from compas_rhino.conversions import frame_to_rhino_plane

random_message = {"header":{"device_id":"43346cc4247caff28bb11990cae936d916f49d57","time_stamp":"2025-01-17 18:17:51.133"},"human_frames":[{"point":[0.612,-0.644,0.304],"xaxis":[0.770177364,-0.4950273,0.4022124],"yaxis":[-0.237605557,-0.807879865,-0.5393272]},{"point":[0.968,0.123,0.566],"xaxis":[0.886972,-0.243457079,0.392440259],"yaxis":[-0.454008132,-0.615335464,0.644390762]},{"point":[1.301,-0.0310001,0.566],"xaxis":[0.485191464,0.09681749,0.8690314],"yaxis":[-0.874221,0.0331599265,0.4843946]}],"robot_frames":[{"point":[0.612,-0.644,0.304],"xaxis":[0.770177364,-0.4950273,0.4022124],"yaxis":[-0.237605557,-0.807879865,-0.5393272]},{"point":[0.968,0.123,0.566],"xaxis":[0.886972,-0.243457079,0.392440259],"yaxis":[-0.454008132,-0.615335464,0.644390762]},{"point":[1.301,-0.0310001,0.566],"xaxis":[0.485191464,0.09681749,0.8690314],"yaxis":[-0.874221,0.0331599265,0.4843946]}],"robot_name":"UR20"}

human_frames = random_message["human_frames"]
a = []

for frame in human_frames:
    print frame
    frame = Frame.__from_data__(frame)
    a.append(frame_to_rhino_plane(frame))
    print type(frame)</item>
