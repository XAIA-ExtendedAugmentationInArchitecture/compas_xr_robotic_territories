                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_rhino.conversions import frame_to_rhino_plane


fp=r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\ur20\joe_transformation_information\pick_place_test.json"
dict = json_load(fp)

new_init_cube_pos = dict['new_init_cube_pos'] 
new_target_cube_pos = dict['new_target_cube_pos']
geo_frame = dict['geo_frame']
pick_frame = dict['geo_frame_pick']
geo_goal_frame = dict['geo_frame_goal']
goal_frame = dict['place_geo_frame']

geo_plane = frame_to_rhino_plane(dict['geo_frame'])
pick_plane = frame_to_rhino_plane(dict['geo_frame_pick'])
geo_goal_plane= frame_to_rhino_plane(dict['geo_frame_goal'])
place = frame_to_rhino_plane(dict['place_geo_frame'])

#print dict</item>
