                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os, math
import sys
from compas.datastructures import Mesh
from compas.data import json_load
from compas.scene import SceneObject

canvas = ghenv.Component.OnPingDocument()
path = canvas.FilePath
dir_path = os.path.dirname(path)
table_dir_path = os.path.join(dir_path, "fabrication", "setup", "table")
mesh_path = os.path.join(table_dir_path, file_name)

if file_name.endswith(".obj"):
    mesh = Mesh.from_obj(mesh_path)
    print (type(mesh))
elif file_name.endswith(".json"):
    mesh = json_load(mesh_path)
    print (type(mesh))
else:
    raise Exception("The filetype of {} is not currently importable".format(file_name))

if show:
    vis = SceneObject(mesh).draw()
</item>
