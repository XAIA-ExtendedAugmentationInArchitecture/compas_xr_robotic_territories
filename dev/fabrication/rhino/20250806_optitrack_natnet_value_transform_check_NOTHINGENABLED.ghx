#    f_data = data["AnchorCube"][i]["rhino_frame"]
#    geo_frame_data = data["AnchorCube"][i]["geometry_frame"]
#    
#    f = Frame.__from_data__(f_data)
#    geo_frame = Frame.__from_data__(geo_frame_data)
#    geo_frame_txed = geo_frame.transformed(tx)
#    box = Box(0.3, 0.3, 0.3, geo_frame)
#    box_tx = box.transformed(tx)
#    
#    txframe = f.transformed(tx)
#    a.append(frame_to_rhino_plane(txframe))
#    b.append(frame_to_rhino_plane(f))
#    geo_frames.append(frame_to_rhino_plane(geo_frame))
#    geo_frames_tx.append(frame_to_rhino_plane(geo_frame_txed))
#    geo.append(box_to_rhino(box))
#    geo_tx.append(box_to_rhino(box_tx))
</item>
