                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_rhino.conversions import frame_to_rhino_plane
from compas.geometry import Frame

frames_fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\testing\random_data_saves\test_requested_robot_frames.json"
frames_data = json_load(frames_fp)
h_frames = frames_data["requested_human_frames"]
r_frames = frames_data["requested_robot_frames"]

h_planes = [frame_to_rhino_plane(frame) for frame in h_frames]
r_planes = [frame_to_rhino_plane(frame) for frame in r_frames]

traj_fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\testing\random_data_saves\test_trajectory_pybullet_planning.json"

trajectories_list = json_load(traj_fp)
combined_points = []
for traj in trajectories_list:
    combined_points.extend(traj.points)


base_frame_fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\testing\random_data_saves\UR20_current_baseframe.json"
base_frame_data = json_load(base_frame_fp)
base_frame = Frame.__from_data__(base_frame_data)
base_plane = frame_to_rhino_plane(base_frame)


</item>
