            <chunk name="Object" index="588">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas.geometry import Frame, Point
from compas.geometry import Quaternion
from compas_rhino.conversions import frame_to_rhino_plane, plane_to_compas_frame
from compas.geometry import Transformation

#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\nat_net_lib_test\samples\out\test_session\recordings\20250528_111927\rigid_bodies_by_timestamp.json"
data = json_load(fp)


time_stamps = []
motive_frames = []
motive_planes = []
frames = []
planes = []

o_frames = []
o_planes = []

t_frames = []
t_planes = []
t_o_planes = []

ur20_data = data["UR20"]
origin_data = data["Origin"]

for i in range(len(ur20_data)):
    position = ur20_data[i]["position"]
    rotation = ur20_data[i]["rotation"]
    timestamp = ur20_data[i]["timestamp"]
    time_stamps.append(timestamp)
    
    motive_pos = Point(position["x"], position["y"], position["z"])
    quat = Quaternion(rotation["w"], rotation["x"], rotation["y"], rotation["z"])
    motive_frame = Frame.from_quaternion(quat, motive_pos)
    motive_frames.append(motive_frame)
    motive_planes.append(frame_to_rhino_plane(motive_frame))
    
    pos_point = Point(-position["x"], position["z"], position["y"])
    
    
    #Position and Orientation Changed...
    frame = Frame.from_quaternion(quat, pos_point)
    frames.append(frame)
    planes.append(frame_to_rhino_plane(frame))



for j in range(len(origin_data)):
    position = origin_data[j]["position"]
    rotation = origin_data[j]["rotation"]
    timestamp = origin_data[j]["timestamp"]
#    time_stamps.append(timestamp)
    quat = Quaternion(rotation["w"], rotation["x"], rotation["y"], rotation["z"])
    pos_point = Point(position["x"], position["y"], position["z"])
    
    o_frame = Frame.from_quaternion(quat, pos_point)
    o_frames.append(o_frame)
    o_planes.append(frame_to_rhino_plane(o_frame))

tx = Transformation.from_frame_to_frame(o_frames[0], plane_to_compas_frame(x))
t_o_planes.append(frame_to_rhino_plane(o_frames[0].transformed(tx)))

for frame in frames:
    t_frame = frame.transformed(tx)
    t_frames.append(t_frame)
    t_planes.append(frame_to_rhino_plane(t_frame))</item>
