                <item name="Name" type_name="gh_string" type_code="10">Python Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from scriptcontext import sticky as st
from ur_fabrication_control.direct_control.utilities import is_available

guid = str(ghenv.Component.InstanceGuid)
txt_key = "txt_" + guid
if txt_key not in st:
    st[txt_key] = ""

if ping:
    
    available = is_available(ip)
    
    if available:
        st[txt_key] = "%s is up!" % ip
        trigger = True
    else:
        st[txt_key] = "%s is down!" % ip
        trigger = False

print(st[txt_key])</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
