data_dict = {
    "UR20": {
        "static": {},
        "observed": {}
    },
    "UR3Table": {
        "UR31": {
            "static": {},
            "observed": {}
        },
        "UR32": {
            "static": {},
            "observed": {}
        }
    },
    "ABBTable": {
        "ABB1": {
            "static": {},
            "observed": {}
        },
        "ABB2": {
            "static": {},
            "observed": {}
        }
    }
}

data_dict["UR20"]["static"]["urdf_base_frame"] = ur20_urdf_base_frame

data_dict["UR3Table"]["UR32"]["static"]["urdf_base_frame"] = "PlaceHolder"
