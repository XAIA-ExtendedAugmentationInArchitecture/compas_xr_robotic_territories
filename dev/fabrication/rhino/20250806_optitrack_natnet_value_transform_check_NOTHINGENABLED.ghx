                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_fab.robots import JointTrajectory
from compas_robots import Configuration
from compas_rhino.conversions import plane_to_compas_frame

class MimicResultData(object):
    trajectories = None
    robot_base_fame = None
    
    def ToString(self):
        return str(self)

    def __str__(self):
        return "Planning result for {} trajectories".format(len(self.trajectories))

if robot_base_frame:
    print options.robot_name
    result = MimicResultData()
    result.trajectories = trajectories
    result.robot_base_frame = plane_to_compas_frame(robot_base_frame)
else:
    result = None</item>
