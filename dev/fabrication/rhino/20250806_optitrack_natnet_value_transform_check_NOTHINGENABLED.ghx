            <chunk name="Object" index="606">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_rhino.conversions import frame_to_rhino_plane, plane_to_compas_frame
from compas.geometry import Transformation
data = json_load(fp)

def get_data_from_object_dict(object_dict, motive_origin, rhino_origin, origin_to_transform_to):

    tf_rhino_planes = []

    motive_frames = object_dict["motive_frames"]
    rhino_frames = object_dict["rhino_frames"]
    motive_planes = [frame_to_rhino_plane(frame) for frame in motive_frames]
    rhino_planes = [frame_to_rhino_plane(frame2) for frame2 in rhino_frames]
    
    frame_y = plane_to_compas_frame(y)
    tx = Transformation.from_frame_to_frame(plane_to_compas_frame(rhino_origin), origin_to_transform_to)
    tf_rhino_origin = frame_to_rhino_plane(plane_to_compas_frame(rhino_origin).transformed(tx))
    
    for frame in rhino_frames:
        tf_rhino_frame = frame.transformed(tx)
        tf_rhino_planes.append(frame_to_rhino_plane(tf_rhino_frame))

    return motive_planes, rhino_planes, tf_rhino_planes




ur20_data = data["UR20"]
print(len(ur20_data["motive_frames"]))
print(len(ur20_data["rhino_frames"]))
blue01_data = data["Blue01"]
print(len(blue01_data["rhino_frames"]))
print(len(blue01_data["motive_frames"]))
red01_data = data["Red01"]
print(len(red01_data["rhino_frames"]))
print(len(red01_data["motive_frames"]))

frame_y = plane_to_compas_frame(y)
motive_origin = frame_to_rhino_plane(data["origin_frame_motive"])
rhino_origin = frame_to_rhino_plane(data["origin_frame_rhino"])

ur20_motive_planes, ur20_rhino_planes, ur20_transformed_planes = get_data_from_object_dict(ur20_data, motive_origin, rhino_origin, frame_y)
print(len(ur20_transformed_planes))
blue01_motive_planes, blue01_rhino_planes, blue01_transformed_planes = get_data_from_object_dict(blue01_data, motive_origin, rhino_origin, frame_y)
red01_motive_planes, red01_rhino_planes, red01_transformed_frames = get_data_from_object_dict(red01_data, motive_origin, rhino_origin, frame_y)
