                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_xr.project.robotic_territories import RoboticTerritoriesProjectManager

if not (config_filepath):
    ghenv.Component.Message = "Missing Config or Data"

elif not (project_name):
    ghenv.Component.Message = "Missing Project Name"

elif not (robot_base_frame):
    ghenv.Component.Message = "Missing Robot Base Frame"

else:
    rtpm = RoboticTerritoriesProjectManager(config_filepath)
    rtpm.database.upload_data_to_reference_as_child(robot_base_frame.__data__, project_name, "robot_base_frame")
</item>
