              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_robots import Configuration

points = trajectory.points

config = points[0]

config.values

first_config = Configuration.from_revolute_values(config.values())</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
