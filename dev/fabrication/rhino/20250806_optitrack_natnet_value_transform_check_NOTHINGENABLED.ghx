              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino.conversions import frame_to_rhino_plane
from compas.geometry import Frame

data = {"rhino_frame": {
        "point": [
          -0.5906088520050049,
          -0.6205720512390136,
          0.48346227884292603
        ],
        "xaxis": [
          0.9967619799618833,
          -0.04854017331393242,
          -0.06410465565869357
        ],
        "yaxis": [
          0.05178559499045063,
          0.9974070361488476,
          0.04997455744933219
        ]
      },
      "marker_type": "passive",
      "geometry_frame": {
        "point": [
          -0.5906088520050049,
          -0.6205720512390136,
          0.48346227884292603
        ],
        "xaxis": [
          0.9967619799618833,
          -0.04854017331393242,
          -0.06410465565869357
        ],
        "yaxis": [
          0.051785594990450635,
          0.9974070361488477,
          0.049974557449332185
        ]
      }
    }

marker_frame_data = data["rhino_frame"]
geometry_frame_data = data["geometry_frame"]
marker_plane = frame_to_rhino_plane(Frame.__from_data__(marker_frame_data))
geometry_plane = frame_to_rhino_plane(Frame.__from_data__(geometry_frame_data))</item>
