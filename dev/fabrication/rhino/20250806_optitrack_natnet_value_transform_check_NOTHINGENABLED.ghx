              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os
import math

from compas.rpc import Proxy
package_path = ghdoc.Path

if send:
    if not config:
        ghenv.Component.Message = "No config to move to!"
    else:
        canvas = ghenv.Component.OnPingDocument()
        path = os.path.abspath(os.path.join(package_path,"../fabrication", "control"))
        rtde = Proxy('fabrication', path=path)
        nowait = True
        a = rtde.move_to_joints(config, speed, accel, nowait, ip=ip)
        ghenv.Component.Message = "Sent config"
</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
                    <item name="EditorLocation" type_name="gh_drawing_point" type_code="30">
                      <X>303</X>
                      <Y>169</Y>
                    </item>
                    <item name="EditorSize" type_name="gh_drawing_size" type_code="32">
                      <W>1114</W>
                      <H>959</H>
                    </item>
