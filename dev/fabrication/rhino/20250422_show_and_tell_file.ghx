                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_robots import Configuration

def trajectory_points_to_configs(trajectory_points):
    configs = [] 
    for trajectory_point in trajectory_points:
        config = Configuration.from_revolute_values(trajectory_point.values())
        configs.append(config)
    return configs

points = trajectory.points

configs_list = trajectory_points_to_configs(points)</item>
