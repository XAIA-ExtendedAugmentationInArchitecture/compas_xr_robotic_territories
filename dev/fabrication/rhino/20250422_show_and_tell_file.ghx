              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os
import math
import time
from scriptcontext import sticky as st
import Grasshopper.Kernel as gh
from compas.rpc import Proxy
from compas.geometry import Translation, Vector, Transformation, Frame

def trajectory_points_to_configs(trajectory_points):
    configs = [] 
    for trajectory_point in trajectory_points:
        config = Configuration(trajectory_point.joint_values, trajectory_point.joint_types, trajectory_point.joint_names)
        configs.append(config)
    return configs

package_path = ghdoc.Path

#Check if value is true and sticky of the value has been updated
if send:
    if not pick_trajectory: #if no frames provided, then display message
        ghenv.Component.Message = "No pick trajectory to move to!"
    
    if not move_trajectory: #if no frames provided, then display message
        ghenv.Component.Message = "No move trajectory to move to!"
    
    if not place_trajectory: #if no frames provided, then display message
        ghenv.Component.Message = "No place trajectory to move to!"
    
    else:
        
        canvas = ghenv.Component.OnPingDocument()
        path = os.path.abspath(os.path.join(package_path,"../fabrication", "control"))
        rtde = Proxy('fabrication', path=path)
        pick_configs = trajectory_points_to_configs(pick_trajectory.points)
        move_configs = trajectory_points_to_configs(move_trajectory.points)
        place_configs = trajectory_points_to_configs(place_trajectory.points)
        
        rtde.pick_and_place_jk(pick_configs, move_configs, place_configs, speed, accel, radius, ip, vaccum_io)
        ghenv.Component.Message = "Sent frames" #display message on component
#        a = st['send_trajectory_key']

else:
            ghenv.Component.Message = "Send has not been received yet" #display message on component = "Send has not been received yet"
    
</item>
