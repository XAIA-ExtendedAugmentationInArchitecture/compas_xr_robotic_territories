                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import time
import Grasshopper, GhPython
import System
import Rhino
import rhinoscriptsyntax as rs

from compas_eve import Message
from compas_eve import Topic
from compas_eve import Publisher
from compas_eve.mqtt import MqttTransport

from compas_xr.mqtt import RealtimeMimicResultMessage
import json

class PlanningServiceResponseComponent(component):
    
    def RunScript(self, options, result, publish):
        if not result:
            self.Message = "Null Result, unable to publish"
            return

        if publish:
            topic_name_result = "robotic_territories/real_time_mimic_result/" + options.project_name
            topic = Topic(topic_name_result, RealtimeMimicResultMessage)
            tx = MqttTransport(options.host)
            publisher = Publisher(topic, transport=tx)
            message = RealtimeMimicResultMessage(
                robot_name = options.robot_name,
                return_message = message
                )
#            message = MimicTrajectoryResultMessage(
#                trajectories=result.trajectories,
#                robot_name=options.robot_name,
#                robot_base_frame=result.robot_base_frame,            
#                )
            publisher.publish(message)
            self.Message = "Send trajectory with #{} trajectories".format(len(result.trajectories))
</item>
