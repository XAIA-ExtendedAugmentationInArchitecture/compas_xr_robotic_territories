            <chunk name="Object" index="68">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate pickup trajectory of a part.
"""
import math
from ghpythonlib.componentbase import executingcomponent as component
from scriptcontext import sticky as st

#from compas.artists import Artist
from compas.scene import Scene
from compas.geometry import Frame
from compas.geometry import Transformation
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane
from compas_fab.ghpython.components import create_id
from compas_fab.robots import AttachedCollisionMesh
from compas_fab.robots import CollisionMesh
from compas_fab.robots import PlanningScene

#from helpers import get_assembly_sequence

class PlanPartPickupTrajectory(component):
    def RunScript(self, robot, group, current_config, ik_solutions, planner_id, compute):
        self.Message = ""

        motion_trajectories = []
        motion_frames = []

        # Clean scene
        if compute and robot and robot.client and robot.client.is_connected:
            scene = PlanningScene(robot)

        if not current_config or not ik_solutions:
            self.Message = "No current_config &amp; ik_solutions defined"
            return motion_trajectories, motion_frames

        try:
            
            for i,ik_solution in enumerate(ik_solutions):
                # Compute MOVE trajectory

                if i == 0:
                    start_config = current_config
                else:
                    start_config = ik_solutions[(i-1)]
                goal_config = ik_solutions[i]
                if compute and robot and robot.client and robot.client.is_connected:
                    planner_id = planner_id or 'TRRT'
        
                    tolerance_above = self._generate_default_tolerances(robot.get_configurable_joints(group))
                    tolerance_below = self._generate_default_tolerances(robot.get_configurable_joints(group))
                    goal_constraints = robot.constraints_from_configuration(
                        configuration=goal_config,
                        tolerances_above=tolerance_above,
                        tolerances_below=tolerance_below,
                        group=group
                    )
        
                    trajectory = robot.plan_motion(goal_constraints,
                                                       start_configuration=start_config,
                                                       group=group,
                                                       options=dict(
                                                       planner_id=planner_id,
            #                                               attached_collision_meshes=attached_collision_meshes
                                                       ))
        
                    motion_trajectory = trajectory
                    motion_trajectories.append(motion_trajectory)

                    if motion_trajectory:
                        for c in motion_trajectory.points:
                            frame = robot.forward_kinematics(c, group, options=dict(solver='model'))
                            motion_frames.extend(frame_to_rhino_plane(frame))

            if len(motion_trajectories) &gt; 0:
                self.Message = "Found Trajectories ({} individual trajectories)".format(len(motion_trajectories))

        except Exception as e:
            import traceback  # Import traceback for detailed error reporting
            print("Error occurred while solving IK:\n", traceback.format_exc())  # Print full traceback for debugging
            raise Exception("Could not solve IK solution. See error details above.")

        return motion_trajectories, motion_frames

    def _generate_default_tolerances(self, joints):
        DEFAULT_TOLERANCE_METERS = .001
        DEFAULT_TOLERANCE_RADIANS = math.radians(1)

        return [
            DEFAULT_TOLERANCE_METERS if j.is_scalable()
            else DEFAULT_TOLERANCE_RADIANS
            for j in joints
        ]</item>
