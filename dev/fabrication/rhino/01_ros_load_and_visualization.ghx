                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.components as ghcomp
import compas_fab
from compas_fab.robots.robot import Configuration

def remap(value, source_min, source_max, target_min, target_max):

    normalized_value = (value - source_min) / (source_max - source_min)
    remapped_value = target_min + normalized_value * (target_max - target_min)
    return remapped_value

def trajectory_points_to_configs(trajectory_points):
    configs = [] 
    for trajectory_point in trajectory_points:
        config = Configuration(trajectory_point.joint_values, trajectory_point.joint_types, trajectory_point.joint_names)
        configs.append(config)
    return configs

if isinstance(selected, compas_fab.robots.trajectory.JointTrajectory):
    selected = trajectory_points_to_configs (selected.points)
    index = int(remap(i, 0.001, 1.00, 0, len(selected) - 1))
    index = min(max(0, index), len(selected) - 1)
    result = selected[index]
elif isinstance(selected, Configuration):
    result = selected
else:
    result = None  

config = result</item>
