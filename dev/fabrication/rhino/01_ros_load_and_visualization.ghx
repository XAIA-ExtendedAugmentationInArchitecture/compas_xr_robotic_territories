                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_robots import Configuration

def shift_list(lst, num_shifts):
    num_shifts %= len(lst)  # Ensure it's within bounds
    return lst[num_shifts:] + lst[:num_shifts]

configurations = []
config_base_list = json_load(fp)

joint_names = ['shoulder_pan_joint', 'shoulder_lift_joint', 'elbow_joint', 'wrist_1_joint', 'wrist_2_joint', 'wrist_3_joint']
joint_types = [0, 0, 0, 0, 0, 0]

for item in config_base_list:
#    config = shift_list(item, shift_val)
#    print (item)
#    config = list(reversed(item))
#    print (config)
    config = item
    c_config = Configuration(joint_values=config,
                                    joint_types=joint_types
                                , joint_names=joint_names)
    configurations.append(c_config)
</item>
