                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_rhino.conversions import frame_to_rhino_plane, mesh_to_rhino
from compas.data import json_load
import os
import sys

canvas = ghenv.Component.OnPingDocument()
path = canvas.FilePath
dir_path = os.path.dirname(path)
robots = ["ur3", "ur5", "ur10e", "ur20"]
robot = robots[robot]
ee_path = os.path.join(dir_path, "fabrication", "setup", "endeffectors", robot, ee_name + ".json")
print (ee_path)

if (ee_name, robot):
    ee_dict = json_load(ee_path)
    
    tcf_plane = frame_to_rhino_plane(ee_dict["tcf"])
    c_visual_mesh = ee_dict["visual_mesh"]
    c_visual_mesh.quads_to_triangles()
    visual_mesh = mesh_to_rhino(c_visual_mesh)
    
    if 'collision_mesh' in ee_dict:
        c_collision_mesh = ee_dict["collision_mesh"]
        c_collision_mesh.quads_to_triangles()
        collision_mesh = mesh_to_rhino(ee_dict["collision_mesh"])
    else:
        collision_mesh = None

else:
    ghenv.Component.Message("Missing EE Info")</item>
