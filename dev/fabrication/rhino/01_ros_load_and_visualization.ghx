              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">random = []

for key, item in enumerate(x):  # key comes first, item second
    data = {
        "joint_names": item.joint_names,
        "joint_types": item.joint_types,
        "joint_values": item.joint_values,  # Comma added
        "key": key  # Key correctly assigned
    }
    random.append(data)

#print random
</item>
