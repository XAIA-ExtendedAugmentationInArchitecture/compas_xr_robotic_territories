                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_dump
from compas_fab.robots import JointTrajectory

configs = []

for trajectory in trajectories:
    configs.extend(trajectory.points)

if dump:
    trajectory = JointTrajectory(configs)
    json_dump(trajectory, fp, pretty=True)</item>
