                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load

if fp:
    trajectories = json_load(fp)
    
    configs = []
    for item in trajectories:
        configs.extend(item.points)

for i,c in enumerate(configs):
    print (i, c.joint_values)</item>
