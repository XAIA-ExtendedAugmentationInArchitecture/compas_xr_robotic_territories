            <chunk name="Object" index="76">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os
from scriptcontext import sticky as st
#sticky is a persistent dictionary which can save values and also be acessed by other GH components
#we use it here with a custom key to store values we read from the robot
from compas.rpc import Proxy
from compas.geometry import Frame
package_path = ghdoc.Path

config_key = 'config_{}'.format(str(ghenv.Component.InstanceGuid))
new_key = 'new_key_{}'.format(str(ghenv.Component.InstanceGuid))
frame_key = 'frame_{}'.format(str(ghenv.Component.InstanceGuid))

if config_key not in st:
    st[config_key] = None

if frame_key not in st:
    st[frame_key] = None

if send:
    canvas = ghenv.Component.OnPingDocument()
    path = os.path.abspath(os.path.join(package_path,"../fabrication", "control"))
    print (path)
    rtde = Proxy('fabrication', path=path)
    st[config_key] = rtde.get_config(ip=ip)
    st[new_key] = rtde.get_config(ip=ip)
    st[frame_key] = robot.forward_kinematics(st[config_key], group, options=dict(solver='model'))
#    a = rtde.get_config(ip=ip)

config = st[config_key]
frame = st[frame_key]

#print "joint values: ", config.joint_values

#frame_WCF = frame_RCF.transformed(robot.transformation_BCF_WCF())
#print frame_RCF</item>
