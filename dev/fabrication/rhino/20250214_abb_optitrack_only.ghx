              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.geometry import Transformation
from compas.geometry import Translation
from compas_rhino.conversions import plane_to_compas_frame, frame_to_rhino_plane

optitrack_robot_frame = plane_to_compas_frame(optitrack_robot_plane)
urdf_base_frame = plane_to_compas_frame(urdf_base_plane)

translation_vec = optitrack_robot_frame.xaxis + optitrack_robot_frame.yaxis
trans_vec_unitized = translation_vec.unitized()
translation_vector = trans_vec_unitized*base_transformation_dist

translation = Translation.from_vector(translation_vector)
robot_base_frame = optitrack_robot_frame.transformed(translation)

transform = Transformation.from_frame_to_frame(urdf_base_frame, robot_base_frame)
inverse_transform = transform.inverse()</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
