from compas_rhino import unload_modules
unload_modules('compas_xr')

import sys
import os
import Rhino.Geometry as rg

from compas_xr.realtime_database import RealtimeDatabase
from compas_xr.project import ProjectManager
from compas.data import json_dumps
from Rhino.Geometry import Polyline
from compas_rhino.conversions import point_to_compas
from compas_rhino.conversions import box_to_compas
import Rhino.Geometry as rg

from compas_xr.project.robotic_territories import RoboticTerritoriesProjectManager

